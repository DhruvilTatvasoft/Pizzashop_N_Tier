@model TableAndSectionViewModel
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
  var canEditTableSection = (await AuthorizationService.AuthorizeAsync(User, "TableAndSection_CanEditAdd")).Succeeded;
  var canDeleteTableSection = (await AuthorizationService.AuthorizeAsync(User, "TableAndSection_CanDelete")).Succeeded;
}
<partial name="_ValidationScriptsPartial" />
<div class="d-flex justify-content-between p-2 ps-4">
  <label class=" c-text">Section</label>
  <button type="submit" class="col-6 d-flex w-25" data-bs-toggle="modal" data-bs-target=""
    style="background: transparent;border: none;margin-left: auto;"><img src="~/images/plus-square copy.svg"
      style="width:75%;margin-top: 5px;"
      onclick="@(canEditTableSection ? "OpenAddSectionModel()" : "showAccessDenied('section','add')")" alt="">
  </button>
</div>

<div class="scrollbar w-100">
  <div class="scrollbox w-100 h-100">
    <ul class="sectionList mt-2 w-100 h-100 ">

      @foreach (var sec in Model.sections)
      {
        <li class="w-100 section" id="selectedSection_@sec.Sectionid" style="display: flex; align-items: center;"
          onclick="loadTableData(@sec.Sectionid,1)">
          <label for="" class="ms-0" style="font-size: 13px; flex-grow: 1; overflow: hidden; text-overflow: ellipsis;">≣
            @sec.Sectionname</label>
          <div class="d-flex">

            <img src="~/images/edit.png" class="pe-2"
              onclick="@(canEditTableSection ? "OpenModalForEdit(@sec.Sectionid)" : "showAccessDenied('section','add')")"
              style="width:25px; cursor:pointer;" alt="">
            <img src="~/images/trash-fill.svg"
              onclick="@(canDeleteTableSection ? "deleteModal(@sec.Sectionid)" : "showAccessDenied('section','delete')")"
              style="width:15px; cursor:pointer;" alt="">
          </div>
        </li>
      }
    </ul>
  </div>
  <div id="loadDeleteModal"></div>
</div>

<form id="addNewSectionForm">
  <div class="modal fade" id="addNewSectionModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="modal-content">
        <div class="modal-header pb-0" style="border:none;">
          <h5 class="modal-title" id="exampleModalLabel">Add New Section</h5>
          <button type="button" class="close" data-bs-dismiss="modal"
            style="margin-left: auto;border: none;background: none;" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <div class="form-group mb-4">
            <input type="text" class="form-control" id="sectionname" style="padding: 3% 4% 3% 2%;" placeholder="Name*"
              asp-for="section.Sectionname">
            <span asp-validation-for="section.Sectionname" class="text-danger"></span>
            <input type="hidden" id="sectionId" asp-for="sectionId">

            <span class="text-danger"></span>
          </div>
          <div class="form-group">
            <textarea class="form-control h-100" placeholder="Description" id="Section-description"
              style="padding: 3% 4% 7% 2%;" asp-for="section.Description"></textarea>
            <span class="text-danger"></span>
          </div>

        </div>
        <div class="modal-footer" style="border: none;">
          <button type="submit" class="btn btn-primary saveNewSection">Save</button>
          <button type="submit" class="btn btn-primary updateSection" data-bs-dismiss="modal">Update</button>
          <button type="button" class="btn btn-outline-primary closebtn" data-bs-dismiss="modal"
            onclick="">Cancel</button>
        </div>
      </div>
    </div>
  </div>
</form>

<script>
  function OpenAddSectionModel() {
    $('#addNewSectionModal').modal('show');
    $('#addNewSectionForm')[0].reset();
    document.querySelector('.modal-title').innerHTML = "Add New Section";
    document.querySelector('.saveNewSection').style.display = 'block';
    document.querySelector('.updateSection').style.display = 'none';
    document.getElementById('addNewSectionForm').action = '@Url.Action("AddNewSection", "TableAndSection")';
  }

  function OpenModalForEdit(sectionId) {
    $('#addNewSectionForm')[0].reset();
    $('#addNewSectionModal').modal('show');
    $.ajax({
      url: '@Url.Action("updateSectionGet", "TableAndSection")',
      type: "GET",
      data: { sectionId: sectionId },
      success: function (data) {
        document.querySelector('.modal-title').innerHTML = "Edit Section";
        document.querySelector('.saveNewSection').style.display = 'none';
        document.querySelector('.updateSection').style.display = 'block';
        $('#sectionname').val(data.section.sectionname);
        $('#Section-description').val(data.section.description);
        $('#sectionId').val(data.section.sectionid);

        document.getElementById('addNewSectionForm').action = '@Url.Action("AddNewSection", "TableAndSection")';

      },
      error: function () {
        alert("Failed to load section data. Please try again.");
      }
    });
  }

  $("#addNewSectionForm").on('submit', function (e) {
    e.preventDefault();
    if ($(this).valid()) {
      var data = new FormData(this);
      $(".saveNewSection, .updateSection").attr("disabled", true);
      var formAction = $(this).attr('action');
      if ($('#sectionId').val() != 0) {
        data.append("section.Sectionid", $('#sectionId').val());
      }
      $.ajax({
        url: formAction,
        type: "POST",
        data: data,
        contentType: false,
        processData: false,
        success: function (data) {
          if (data.error) {
            $(".closebtn").click();
            toastr.error("Section already exists");
          }
          else {
            $('#addNewSectionModal').modal('hide');
            $(".closebtn").click();
            loadSections();
            loadTablePage(data.sectionid)
            toastr.success(data.success);
          }
        },
        complete: function () {
          $(".saveNewSection, .updateSection").attr("disabled", false);
        }
      });
    }
  });

  function deleteModal(sectionId) {
    $.ajax({
      url: '@Url.Action("deleteModalGet", "TableAndSection")',
      type: "GET",
      data: { sectionId: sectionId },
      success: function (data) {
        $("#loadDeleteModal").html(data);
        $("#deleteForTableSAndSectionModel").modal('show');
        $("#deleteText").text("Are you sure you want to delete this section?");

        document.querySelector("#deleteMultipletable").style.display = "none";
        $("#deleteId").val(sectionId);
      }
    });
  }

  $(document).on('submit', '#deleteFormForSectionAndTable', function (e) {
    e.preventDefault();
    let sectionId = $("#deleteId").val();
    $.ajax({
      url: '@Url.Action("deleteSection", "TableAndSection")',
      type: "POST",
      data: { sectionId: sectionId },
      success: function (data) {
        $('#deleteForTableSAndSectionModel').modal('hide');
        loadSections();
        loadTablePage(data.sectionid)

        toastr.success("Section Deleted successfully");
      },
      error: function () {
        alert("Failed to delete the section.");
      }
    });
  });
</script>