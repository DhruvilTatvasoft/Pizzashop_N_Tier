@{
Layout = null;
}
@model TableAndSectionViewModel
<div class="w-100" style="position: relative; height: 235px; overflow-y: auto;">
 <table class="table">
<thead>
   <tr>
      <th scope="col">
         <div class="form-check ps-4">
            <input class="form-check-input col1" type="checkbox" style="width:1em;height:1em;" value="" id="flexCheckDefault">
            <label class="form-check-label" for="flexCheckDefault">
            Name 
            </label>
         </div>
      </th>
      <th scope="col">
         <div class="form-check">
            <label class="form-check-label d-flex align-items-center justify-content-center" for="flexCheckDefault" >
            Capacity
            </label>
         </div>
      </th>
      <th scope="col"><label for="" class="d-flex align-items-center justify-content-center">Status</label></th>
      <th scope="col">Action</th>
   </tr>
</thead>
<input type="hidden" id="sectionIdFortables" asp-for="@Model.sectionId">

<tbody>

   @if(Model.tables.Count() == 0){
      <tr>
         <td colspan="8" class="text-center"><img src="~/images/exclamation-circle-fill.svg" class="p-3" alt="">No
                    Tables Found</td>
      </tr>
   }
   @foreach (var table in Model.tables)
   {
   <tr>
      <th scope="row" class="w-50">
         <input class="form-check-input checkedTable" type="checkbox" value="@table.Tableid" />
         <label class="form-check-label" for="flexCheckDefault">
         <label for="" style="font-size: 14px;">@table.Tablename</label>
         </label>
      </th>
      <td ><label for="" class="d-flex align-items-center justify-content-center">@table.Capacity</label></td>
      <td > <div class="d-flex align-items-center justify-content-center">@if(table.Status){
          <span class="badge bg-success"><label for="" class="d-flex align-items-center justify-content-center">Available</label></span>
         }else
         {
          <span class="badge bg-secondary"><label for="">Occupied</label></span>
         }
         </div>
      </td>
      <td>
         <div class="d-flex justify-content-start w-100 pb-2 h-100">
            <img src="~/images/pencil-square.svg" style="cursor: pointer;" onclick="openEditModal(@table.Tableid)" class="me-2"  alt="">
            <img src="~/images/trash-fill.svg" style="cursor: pointer;" onclick="openSingleDeleteModal(@table.Tableid)" alt="" >
         </div>
      </td>
   </tr>
   }
   </table>
   </div>
   <div class="d-flex justify-content-end align-items-center w-100" style="position: sticky;bottom: 0;z-index: 10;">
      <label for="" class="me-2">items per page:</label>
      <div class="dropdown mt-2 me-2">
        <select class="form-select form-select-lg mb-3 pagesize" aria-label=".form-select-lg example">
         
          <option value="1" selected="@(Model.PageSize == 1 ? "selected" : null)">1</option>
          <option value="2" selected="@(Model.PageSize == 2 ? "selected" : null)">2</option>
          <option value="3" selected="@(Model.PageSize == 3 ? "selected" : null)">3</option>
          <option value="4" selected="@(Model.PageSize == 4 ? "selected" : null)">4</option>
          <option value="5" selected="@(Model.PageSize == 5 ? "selected" : null)">5</option>
          <option value="6" selected="@(Model.PageSize == 6 ? "selected" : null)">6</option>
        </select>
      </div>
@{
    int startRecord = ((Model.PageNumber - 1) * Model.PageSize) + 1;
    int endRecord = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalTables);
}
<label for="" class="me-2">Showing @startRecord-@endRecord of @Model.TotalTables</label>    <div class="d-flex mt-1">

@if(Model.PageNumber > 1){
      <button type="button" class="btn btn-outline-dark btn2" style="padding: 6px;" onclick="loadTableData(@Model.sectionId, @(Model.PageNumber-1),@Model.PageSize)"><img src="" alt=""><img src="~/images/left-chevron-svgrepo-com.svg"
          style="width:25px" alt=""></button>
}
else{
      <button type="button" class="btn btn-outline-dark btn2" style="padding: 6px;" onclick="loadTableData(@Model.sectionId, @(Model.PageNumber-1),@Model.PageSize)" disabled><img src="" alt=""><img src="~/images/left-chevron-svgrepo-com.svg"
          style="width:25px" alt=""></button>
}

          
      @if(Model.PageNumber*Model.PageSize < Model.TotalTables){
      <button type="button" class="btn btn-outline-dark btn2 mb-2" style="padding: 5.8px;" onclick="loadTableData(@Model.sectionId, @(Model.PageNumber+1),@Model.PageSize)"><img src="~/images/left-chevron-svgrepo-com.svg"
          style="width:25px;rotate: 180deg;" alt=""></button>
      }
      else{
      <button type="button" class="btn btn-outline-dark btn2 mb-2" style="padding: 5.8px;" onclick="loadTableData(@Model.sectionId, @(Model.PageNumber+1),@Model.PageSize)" disabled><img src="~/images/left-chevron-svgrepo-com.svg"
          style="width:25px;rotate: 180deg;" alt=""></button>

      }
    </div>
    </div>
    

   

    

<script>

document.getElementById('flexCheckDefault').addEventListener('change', function () {
    const isChecked = this.checked;
    document.querySelectorAll('.checkedTable').forEach(cb => cb.checked = isChecked);
});


$(document).on('change', '.checkedTable', function () {
    const all = $('.checkedTable').length;
    const checked = $('.checkedTable:checked').length;

    $('#flexCheckDefault').prop('checked', all === checked);
});

$(".pagesize").on("change", function () {
    var sectionId = $("#sectionIdFortables").val() || 1; 
    loadTableData(sectionId, 1, this.value); 
});
</script>


  