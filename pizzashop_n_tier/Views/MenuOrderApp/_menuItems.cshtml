@model MenuOrderAppModel

<div class="w-100 h-100 mt-4 d-flex">
    <div class="row pe-0 w-100 mb-0">
        <div class="d-flex justify-content-between " style="height: 9%;width: 50%;">
            <div class="form-group searchInput">
                <input type="text" class="form-control" onkeyup="loadItemsForCategory(@Model.categoryId)"
                    id="searchItemForCategory" aria-describedby="emailHelp" placeholder="Search">
                <span id="search-icon">
                    <input type="hidden" id="selectedCategory" asp-for="categoryId"/>
                    <img src="~/images/icons8-search-30.png" style="width: 20px;" alt="">
                </span>
            </div>
            <div class="d-flex flex-sm-column flex-lg-row">
                <li id="veg" class="me-3">Veg </li>
                <li id="non-veg" class="me-3">Non-veg</li>
                <li id="vegan" class="me-3">Vegan @Model.isTableAssigned</li>
            </div>
        </div>
        <div class="d-flex" style="height: 92%;">
        <div class="menuDataContainer d-flex pt-0 mt-0 pe-0 w-50" style="height: 92%;"></div>
        <div class="orderDetailContainer d-flex pt-0 mt-0 pe-0 w-50" style="height: 100%;"></div>
        </div>

<div id="itemDetailsModalContainer"></div>
<script>
     var totalAmount = 0;
    $("document").ready(() => {
        if($("#IsTableAssigned").val() == "False") {
          $(".menuDataContainer").addClass("menuDataContainer d-flex pt-0 mt-0 pe-0 w-100")
          $(".orderDetailContainer").addClass("orderDetailContainer d-none pt-0 mt-0 pe-0 w-50")
        }
    });
    var favorites = [];
    function AddToFavorite(x, id) {
        console.log(x)
        if ($(x).attr("src") == "/images/heart-fill.svg") {
            $(x).attr("src", "/images/heart.svg");
            if (!favorites.includes(id)) {
                favorites.pop(id);
            }
        }
        else {
            $(x).attr("src", "/images/heart-fill.svg");
            favorites.push(id);
        }

    }

    $("document").ready(()=>{
        loadItemsForCategory(0);
    })
</script>
