@model MenuOrderAppModel
<style>
    .itemCard{ 
       background-color:white;
       @* clip-path: polygon(0% 0%, 100% 100%, 100% 0%) !important; *@
       border-radius: 7px !important;
       box-shadow: 1px 2px 4px 1px rgba(0, 0, 0, 0.3), 0 0px 11px 0 rgba(0, 0, 0, 0);
       @* clip-path: polygon(0% 0%, 100% 100%, 100% 0%) !important; *@
    }
    .itemimage{
    height: 100%;
    border-radius: 7px;
    width: 100%;
   box-shadow: 1px 2px 4px 1px rgba(0, 0, 0, 0.3), 0 0px 11px 0 rgba(0, 0, 0, 0);
    display: flex;
    align-items: center;
    }
    .imageContainer{
        width: 34%;
        height: 100%;
        @* border: 1px solid ; *@
    }
    .itemDetailContainer{
        width: 100%;
    }
    .typeIndicator{
        width: 28px !important;
    height: 20px;
     clip-path: polygon(0% 0%, 100% 100%, 100% 0%) !important;
     border-top-right-radius: 7px !important;
     
    }

</style>
<div class="w-100 mt-3">
    <div class="row" style="gap:20px;">
        @foreach(var item in Model.items){
        <div class="col-3 p-0 d-flex itemCard" onclick="" style="width:20%; background-color:white">
            <div class="imageContainer">
                <div class="w-100 h-100">
                    @if(item.Itemimage != null){
                    <img src="@item.Itemimage" class="itemimage" alt="">
                    }
                    else{
                    <img src="~/images/dining-menu.png" class="itemimage" alt="">
                    }
                </div>
            </div>
            <div class="itemDetailContainer pt-0 pe-0 d-flex justify-content-between p-2">
                <div class="d-flex flex-column">
                <label for="">@item.Itemname</label>
                <label for="">@item.Itemrate</label>
                </div>
                @if(item.Itemtype){
                <div class="d-flex justify-content-between flex-column" >
                    <div class="typeIndicator p-2" style="background-color: green;">
                </div>
                <img src="~/images/heart.svg" class="AddToFavorite" onclick="AddToFavorite(this,@item.Itemid)"  onclick="AddToFavorite(this,@item.Itemid)" style="width: 15px;"  alt="">
                </div>

                }
                else{
                   <div class="d-flex justify-content-between flex-column" >
                    <div class="typeIndicator p-2" style="background-color: red ;">
                    </div>
                <img src="~/images/heart.svg" class="AddToFavorite" onclick="AddToFavorite(this,@item.Itemid)" style="width: 15px;" alt="">
                </div> 
                }
            </div>
        </div>

        }
    </div>
</div>

<script>
    var favorites = []; 
    function AddToFavorite(x,id){
        @* alert("clicked") *@
        @* $(this).prop("src","~/images/heart-fill.svg"); *@
        console.log(x)
        if($(x).attr("src") == "/images/heart-fill.svg"){
            $(x).attr("src","/images/heart.svg");
            if(!favorites.includes(id)){
            favorites.pop(id);
            }
        }
        else{
            $(x).attr("src","/images/heart-fill.svg");
            favorites.push(id);
        }

    }
</script>