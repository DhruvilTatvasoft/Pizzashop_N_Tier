@model MenuOrderAppModel
<partial name="_ValidationScriptsPartial" />
<div style="position: relative;margin-top: -4.8%;" class="p-2 pt-0 w-100">
    <div class="p-3 bg-white rounded d-flex flex-column  order-details" style="position: absolute;width:100%;">
        <div class="d-flex justify-content-between">
            <div>
                <div class="tableImage">
                    <img src="~/images/dinner-table.png" style="width: 35px;height:35px;" alt="">
                </div>
                <div class="d-flex flex-column">
                    <h6><b>@Model.customer.section.Sectionname</b></h6>
                    <p>Table: @string.Join(",", Model.customer.tables.Select(table => table.Tablename))</p>
                    <input type="hidden" id="SavedOrderid">
                </div>
            </div>
            <div>
                <button class="btn btn-outline-primary btnoutlinecolour pt-1"><img src="~/images/qr-code-scan.svg"
                        alt=""></button>
                <button class="btn btn-outline-primary btnoutlinecolour pt-1"
                    onclick="showCustomerDetails(@Model.customer.customerId)"><img
                        src="~/images/person-lines-fill (1).svg" alt=""></button>
                <button class="btn btn-outline-primary btnoutlinecolour pt-1" type="button" using
                    Org.BouncyCastle.Crypto.Engines; onclick="openOrderCommentModal()"><img src="~/images/chat-text.svg"
                        alt=""></button>
            </div>
        </div>
        <div class="parentDivForAccordians m-1 mt-0">
            <div class="accordion" id="orderSummaryContainer">
                <div class="d-flex fw-bold border-bottom pb-2 mb-2">
                    <div class="w-50">Item</div>
                    <div class="w-25 me-5 ms-3">Quantity</div>
                    <div class="w-25 me-4">Amount</div>
                </div>
            </div>
        </div>
        <div>
            <div class="d-flex justify-content-between"><span>Subtotal</span><span id="subtotal">₹0</span></div>
            @foreach (var tax in Model.taxesandfees.OrderBy(Tax => Tax.Taxname))
            {
                <div class="d-flex justify-content-between">
                    <div>
                        @if (Model.appliedTax?.Count > 0)
                        {
                            if (Model.appliedTax.Any(Tax => Tax.taxname == tax.Taxname))
                            {
                                <input type="checkbox" id="isTaxApplied_@tax.Taxname" data-taxname="@tax.Taxname"
                                    data-taxType="@tax.Taxtype" data-taxPercentage="@tax.Taxpercentage"
                                    onchange="appliedTaxOrNot(this,@tax.Taxpercentage,'@tax.Taxtype','@tax.Taxname')" checked />
                            }
                            else
                            {
                                <input type="checkbox" id="isTaxApplied_@tax.Taxname" data-taxname="@tax.Taxname"
                                    data-taxType="@tax.Taxtype" data-taxPercentage="@tax.Taxpercentage"
                                    onchange="appliedTaxOrNot(this,@tax.Taxpercentage,'@tax.Taxtype','@tax.Taxname')" />
                            }
                        }
                        else
                        {
                            <input type="checkbox" id="isTaxApplied_@tax.Taxname" data-taxname="@tax.Taxname"
                                data-taxType="@tax.Taxtype" data-taxPercentage="@tax.Taxpercentage"
                                onchange="appliedTaxOrNot(this,@tax.Taxpercentage,'@tax.Taxtype','@tax.Taxname')" checked />
                        }
                        <span>@tax.Taxname</span>
                    </div>
                    <span id="tax_@tax.Taxname" data-taxPercentage="@tax.Taxpercentage" data-taxType="@tax.Taxtype"></span>
                </div>
            }
            <div class="d-flex justify-content-between fw-bold mt-2 border-top pt-2">
                <span>Total</span><span id="totalamount"></span>
            </div>
        </div>
        <div class="mt-3 d-flex justify-content-between ">
            <label class="mb-1 fw-bold">Payment Method</label>
            <div class="d-flex gap-3 mb-3">
                <div><input type="radio" name="payment" value="Cash" checked /> Cash</div>
                <div><input type="radio" name="payment" value="Card" /> Card</div>
                <div><input type="radio" name="payment" value="UPI" /> UPI</div>
            </div>
        </div>
        <div>
            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-primary btncolour" style="width: 20%;" onclick="saveTheOrder()">Save</button>
                <input type="hidden" id="savedOrNot" value="false">
                <button class="btn btn-outline-primary btnoutlinecolourLight"
                    onclick="CompleteTheOrder()">Complete</button>
                <button class="btn btn-outline-primary btnoutlinecolourLight">Generate Invoice</button>
            </div>
            <div class="d-flex justify-content-end mt-3">
                <button class="btn btn-outline-primary btnoutlinecolour" onclick="cancelTheOrder()">Cancel</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="orderCommentModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Orderwise comment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                </button>
            </div>
            <form id="orderCommentForm">
                <div class="modal-body">
                    <textarea class="form-control" placeholder="Comment" id="orderComment"
                        asp-for="orderComment"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary btncolor" onclick="postorderComment()"
                        id="postTheOrderComment">Save</button>
                    <button type="button" class="btn btn-outline-primary btnoutlinecolor closeOrderCommentModal"
                        data-bs-dismiss="modal">cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>


<script>

    $(document).ready(function () {
        var uniqueids = @Html.Raw(Json.Serialize(Model.uniqueids));
        var orderComment = @Html.Raw(Json.Serialize(Model.orderComment));
        if (orderComment && orderComment !== "") {
            $("#orderComment").val(orderComment);
        }
        if (uniqueids.length > 0) {
            uniqueids.forEach(function (uniqueid) {
                var parts = uniqueid.split('_');
                var itemid = parseInt(parts[1]);
                var modifierids = parts.slice(2).map(function (modifierid) {
                    return parseInt(modifierid);
                });
                addNewItemInOrder(itemid, modifierids, uniqueid);
            });
        }
    });
    function saveTheOrder() {
        var itemDetails = [];
        if ($('[id^="item_"]').length == 0) {
            toastr.error("Add some items before saving the order");
            return;
        }
        console.log(itemWiseComment)
        $('[id^="item_"]').each(function (index, element) {
            var fullId = $(element).attr('id');
            var parts = fullId.split("_");
            if (parts[2] != 'modifier') {
                var itemId = parts[1];
                var modifierIds = parts.slice(2);
                var item = itemWiseComment.find(item => item.uniqueid == fullId);
                if (item == null || item == undefined) {
                    itemcomment = ""
                }
                else {
                    itemcomment = item.Instruction
                }
                itemDetails.push({
                    itemId: itemId,
                    modifierIds: modifierIds,
                    quantity: $("#" + fullId + " .textInputForCounterInOrderItemDetailsKOT").val(),
                    itemcomment: itemcomment,
                    uniqueid: fullId
                });
            }
        });

        var appliedTaxes = $("[id^='isTaxApplied_']:checked");
        var taxesForOrder = [];
        appliedTaxes.each(function () {
            var tax = {
                taxname: $(this).data("taxname"),
                taxtype: $(this).data("taxtype"),
                taxPercentage: $(this).data("taxpercentage")
            }
            taxesForOrder.push(tax);
        })
        console.log(appliedTaxes)
        var tableids = @Html.Raw(Json.Serialize(Model.customer.tableids));
        var customerid = @Html.Raw(Json.Serialize(Model.customer.customerId));
        var totalamount = parseFloat($('#totalamount').text().replace('₹', ''));
        var totalPersons =  @Html.Raw(Json.Serialize(Model.customer.PersonCount));
        var sectionId = @Html.Raw(Json.Serialize(Model.customer.section.Sectionid));
        var orderDetails = {
            tableids: tableids,
            customerid: customerid,
            itemDetails: itemDetails,
            totalamount: totalamount,
            totalPersons: totalPersons,
            ordercomment: orderComment,
            PaymentMethod: $('input[name="payment"]:checked').val(),
            sectionId: sectionId,
            appliedTaxes: taxesForOrder,
            orderid: @Html.Raw(Json.Serialize(Model.orderid)),
            uniqueids: [...new Set($("[id^='item_']").map(function () { return this.id; }).get())]
        }

        console.log(orderDetails);

        $.ajax({
            url: "@Url.Action("saveTheOrderDetails", "MenuOrderApp")",
            type: "POST",
            contentType: "application/json",
            dataType: "json",
            data: JSON.stringify(orderDetails),
            success: function (response) {
                toastr.success(response.success);
                $("#savedOrNot").val(true);
            },
            error: function (xhr, status, error) {
                console.error("Error saving the order:", error);
                toastr.error("There was an issue saving the order.");
            }
        });
    }

    function CompleteTheOrder() {
        var itemDetails = [...new Set($("[id^='item_']").map(function () { return this.id; }).get())];
        var itemIds = {
            uniqueids: itemDetails,
            orderid: @Html.Raw(Json.Serialize(Model.orderid))
       }
        console.log(@Html.Raw(Json.Serialize(Model.orderid)))
        $.ajax({
            url: "@Url.Action("completeTheOrder", "MenuOrderApp")",
            type: "POST",
            contentType: "application/json",
            dataType: "json",
            data: JSON.stringify(itemIds),
            success: function (response) {
                if (response.success) {
                    toastr.success(response.success);
                }
                else {
                    toastr.error(response.error);
                }
            }
        });

    }

    function cancelTheOrder() {
        var itemDetails = [...new Set($("[id^='item_']").map(function () { return this.id; }).get())];
        var itemIds = {
            uniqueids: itemDetails,
            orderid: @Html.Raw(Json.Serialize(Model.orderid))
       }
       debugger
        $.ajax({
            url: "@Url.Action("cancelTheOrder", "MenuOrderApp")",
            type: "POST",
            contentType: "application/json",
            dataType: "json",
            data: JSON.stringify(itemIds),
            success:function(response){
                if(response.success){
                    toastr.success(response.success);
                }
                else{
                    toastr.error(response.error);
                }
            }
        });
    }

</script>