@model MenuOrderAppModel
<partial name="_ValidationScriptsPartial" />
<div style="position: relative;margin-top: -4.8%;" class="p-2 pt-0 w-100">
    <div class="p-3 bg-white rounded d-flex flex-column  order-details" style="position: absolute;width:100%;">
        <div class="d-flex justify-content-between">
            <div>
                <div class="tableImage">
                    <img src="~/images/dinner-table.png" style="width: 35px;height:35px;" alt="">
                </div>
                <div class="d-flex flex-column">
                    <h6><b>@Model.customer.section.Sectionname</b></h6>
                    <p>Table: @string.Join(",", Model.customer.tables.Select(table => table.Tablename))</p>
                </div>
            </div>
            <div>
                <button class="btn btn-outline-primary btnoutlinecolour pt-1"><img src="~/images/qr-code-scan.svg"
                        alt=""></button>
                <button class="btn btn-outline-primary btnoutlinecolour pt-1"
                    onclick="showCustomerDetails(@Model.tokenid)"><img src="~/images/person-lines-fill (1).svg"
                        alt=""></button>
                <button class="btn btn-outline-primary btnoutlinecolour pt-1" type="button"
                    onclick="openOrderCommentModal()"><img src="~/images/chat-text.svg" alt=""></button>
            </div>
        </div>

        <div class="parentDivForAccordians m-1 mt-0">
            <div class="accordion" id="orderSummaryContainer">
                <div class="d-flex fw-bold border-bottom pb-2 mb-2">
                    <div class="w-50">Item</div>
                    <div class="w-25 me-5 ms-3">Quantity</div>
                    <div class="w-25 me-4">Amount</div>
                </div>
            </div>
        </div>

        <div>
            <div class="d-flex justify-content-between"><span>Subtotal</span><span id="subtotal">₹0</span></div>
            @foreach (var tax in Model.taxesandfees.OrderBy(Tax => Tax.Taxname))
            {
                <div class="d-flex justify-content-between">
                    <div><input type="checkbox"
                            onchange="appliedTaxOrNot(this,@tax.Taxpercentage,'@tax.Taxtype','@tax.Taxname')"
                            checked><span>@tax.Taxname</span></div><span id="tax_@tax.Taxname"
                        data-taxPercentage="@tax.Taxpercentage" data-taxType="@tax.Taxtype"></span>
                </div>
            }
            <div class="d-flex justify-content-between fw-bold mt-2 border-top pt-2">
                <span>Total</span><span id="totalamount"></span>
            </div>
        </div>
        <div class="mt-3 d-flex justify-content-between ">
            <label class="mb-1 fw-bold">Payment Method</label>
            <div class="d-flex gap-3 mb-3">
                <div><input type="radio" name="payment" /> Cash</div>
                <div><input type="radio" name="payment" /> Card</div>
                <div><input type="radio" name="payment" /> UPI</div>
            </div>
        </div>
        <div>
            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-primary btncolour" style="width: 20%;">Save</button>
                <button class="btn btn-outline-primary btnoutlinecolourLight">Complete</button>
                <button class="btn btn-outline-primary btnoutlinecolourLight">Generate Invoice</button>
            </div>
            <div class="d-flex justify-content-end mt-3">
                <button class="btn btn-outline-primary btnoutlinecolour">Cancel</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="orderCommentModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Orderwise comment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                </button>
            </div>
            <form id="orderCommentForm">
                <div class="modal-body">
                    <textarea class="form-control" placeholder="Comment" id="orderComment"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary btncolor" onclick="postorderComment()" id="postTheOrderComment">Save</button>
                    <button type="button" class="btn btn-outline-primary btnoutlinecolor closeOrderCommentModal"
                        data-bs-dismiss="modal">cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>