@model MenuOrderAppModel
<div class="modal fade" id="itemDetailsModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle"
    aria-hidden="true" style="--bs-modal-width: 592px;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">@Model.item.Itemname </h5>
                <input type="hidden" value="@Model.item.Itemid" id="itemId" />
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                </button>
            </div>
            <div class="modal-body">
                @if (Model.modifiersForItem.Count > 0)
                {
                    @foreach (var item in Model.modifiersForItem)
                    {
                        <div id="modifierGroup_@item.modifiergroup.Modifiergroupid" data-modifierGroupid="@item.modifiergroup.Modifiergroupid" data-min-value="@item.min_value" data-max-value="@item.max_value">
                        <label><span class="modifierGroupName">@item.modifiergroup.Modifiergroupname options :</span> (You can
                            choose Minimum - @item.min_value &
                            Maximum - @item.max_value options)</label>
                        @if (item.modifiers.Count > 0)
                        {
                            <div class="row w-100 g-2 mt-2 mb-2" style="gap: 2%;">
                                @foreach (var modifier in item.modifiers)
                                {
                                    @* <label>@modifier.Modifiername - @modifier.Modifierrate</label> *@
                                        <div class="modifierDetailContainer pt-0 pe-0 d-flex justify-content-between p-2 col-3"
                                            data-modifierid="@modifier.Modifierid" style="cursor:pointer;"
                                            onclick="addItemInOrder(this,@modifier.Modifierid)" id="modifier_@modifier.Modifierid"
                                            style="width: 23%;">
                                            <div class="d-flex flex-column">
                                                <label for="">@modifier.Modifiername @modifier.Modifierid</label>
                                                <label for="" >₹ @modifier.Modifierrate </label>
                                            </div>
                                            <div class="d-flex justify-content-between flex-column">
                                                <div class="typeIndicatorForModifier p-2" style="background-color: rgb(244 182 32);">
                                                </div>
                                            </div>
                                        </div>


                                }
                            </div>
                        }
                        </div>
                    }
                }
                else
                {
                    <div>
                        <label class="d-flex align-items-center justify-content-center"><img
                                src="~/images/exclamation-circle-fill.svg" class="p-3" alt="">No Modifiers Found</label>
                    </div>
                }
                @if (Model.isTableAssigned)
                {
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-primary btnoutlinecolour cancelButton"
                            data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary btncolour" onclick="addItemsInOrder(@Model.item.Itemid)">Add</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    var modifiers = [];
   
    function addItemsInOrder(itemid){
         var modifiergroups = $('[id^="modifierGroup_"]');
         var isValid = true;
        modifiers = [];
        var uniqueId = "item_" + itemid;
        modifiergroups.each(function (index, group) {
            var minValue = parseInt($(group).data('min-value'));
            var maxValue = parseInt($(group).data('max-value'));
            var selected = $(group).find('.selectedModifierDetailContainer');

            if (selected.length < minValue || selected.length > maxValue) {
                isValid = false;
                if(selected.length < minValue){
                    toastr.error("Please select minimum " + minValue + " modifiers");
                    }
                    else{
                    toastr.error("Please select Maximum " + maxValue + " modifiers");
                    }
                return false; 
            }

            selected.each(function () {
                modifiers.push($(this).data('modifierid'));
                
            });
            modifiers.sort(function(a, b) {
                return a - b;
            });

        });
        for (var i = 0; i < modifiers.length; i++) {
            uniqueId += "_" + modifiers[i];
        }
        if(document.querySelector("#"+uniqueId+" .textInputForCounterInOrderItemDetailsKOT")){
            alert("found")
            var quantity = $("#"+uniqueId+" .textInputForCounterInOrderItemDetailsKOT").val();
            var price = $("#"+uniqueId).data("itemrate");
            var modifierrate = $("#"+uniqueId+"_modifier_rate").val();
            @* alert($("#"+uniqueId+" .textInputForCounterInOrderItemDetailsKOT").val()) *@
            $("#"+uniqueId+" .textInputForCounterInOrderItemDetailsKOT").val(parseInt(quantity) + 1);
            var subtotalValue = parseFloat($("#subtotal").text().replace("₹", ""));
            console.log(price+" "+modifierrate);
            subtotalValue += parseFloat(price);
            subtotalValue += parseFloat(modifierrate);
            $("#subtotal").text("₹" + subtotalValue.toFixed(2));
            totalAmount += parseFloat(price);
            totalAmount += parseFloat(modifierrate);
            isValid = false;
        }
        if (!isValid) return;
        $.ajax({
            url:"@Url.Action("addItemInOrder","MenuOrderApp")",
            type: "POST",
            data:{itemid : itemid, modifiers: modifiers,uniqueId : uniqueId},
            success:function(response){

                $("#orderSummaryContainer").append(response);
                console.log(totalAmount)
                @* totalAmount += parseInt($(uniqueId).data("itemrate") + parseFloat($("#"+uniqueId + " .modifierrate").val())*$("#"+uniqueId + " .textInputForCounterInOrderItemDetailsKOT").val()); *@
                var itemprice = parseFloat($("#"+uniqueId).data("itemrate"));
                var quantity = parseInt($("#"+uniqueId+" .textInputForCounterInOrderItemDetailsKOT").val());
                var modifiersrate = parseFloat($("#"+uniqueId+" .modifierrate").data("modifierrate"));
                console.log("itemprice : "+itemprice);
                console.log("modifiersrate : "+modifiersrate);
                console.log("modifiersrate : "+quantity);
                totalAmount += (itemprice + modifiersrate) * quantity;
                $("#subtotal").text("₹"+totalAmount);
                $(".cancelButton").click()
            }
        });

        console.log("Item ID: " + itemid);
        console.log("Selected Modifiers: ", modifiers);
    }


    function addItemInOrder(element, modifierid) {
        var modifiergroups = $('[id^="modifierGroup_"]');

        modifiergroups.each((group)=>{
            var minValue = parseInt($(group).data('min-value'));
            var maxValue =parseInt($(group).data('max-value'));
            var selectedModifiers = $(group).find('.selectedModifierDetailContainer').length;
        })

       if ($(element).hasClass("modifierDetailContainer")) {
            $(element).removeClass("modifierDetailContainer")
            $(element).addClass("selectedModifierDetailContainer")
        }
        else {
            $(element).removeClass("selectedModifierDetailContainer")
            $(element).addClass("modifierDetailContainer")
        }
    }

    
</script>
