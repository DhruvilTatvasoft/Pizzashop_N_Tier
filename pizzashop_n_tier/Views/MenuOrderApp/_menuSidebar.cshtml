@model MenuOrderAppModel
<div>
   <h4 class="p-3 pb-1">Category</h4>
   <ul>
      <li class="categoryForMenuPage" id="allCategorySelected"onclick="loadItemsForCategory(this,0,itemType)">All</li>
      @foreach (var category in Model.categories)
      {
         <li class="categoryForMenuPage" onclick="loadItemsForCategory(this ,@category.Categoryid ,itemType)">@category.Categoryname</li>
      }
   </ul>
</div>

