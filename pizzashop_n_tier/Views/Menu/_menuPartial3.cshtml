@{
    Layout = "";
}
@model ItemModel
<table class="table">
    <thead>
        <tr>
            <th scope="col">
                <div class="form-check">
                    <input class="form-check-input col1 ms-0 me-3"  type="checkbox" value="" id="flexCheckDefault">
                    <label class="form-check-label" for="flexCheckDefault">
                        Name
                    </label>
                </div>
            </th>
            <th scope="col">
                <div class="form-check">
                    <label class="form-check-label" for="flexCheckDefault">
                        ItemType
                    </label>
                </div>
            </th>
            <th scope="col">Rate</th>
            <th scope="col" ><label for="">Quantity</label></th>
            <th scope="col">Available</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @if(@Model.items.Count <= 0){
            <tr>
                <td>
               
                </td>
                <td></td>
                <td></td>
                <td> <div class="d-flex align-items-center"><img src="~/images/exclamation-circle-fill.svg" class="p-3" alt=""><label for="">No records found</label></div></td>
                <td></td>
                <td></td>
                </tr>
        }
        else{
        @foreach (var item in Model.items)
        {
            <tr>
                <th scope="row">
                    <input class="form-check-input checkedItems" type="checkbox" value="@item.Itemid" />
                    <label class="form-check-label" for="flexCheckDefault">
                        @if(item.Itemimage != null){
                        <img src="@item.Itemimage" style="width:30px;height: 30px" alt="">
                        }
                        else{
                            <img src="~/images/3d24fae1-694f-407f-82ad-ce0d6beaf876_dinner-icon.png"style="width:30px;height: 30px" alt="">
                        }
                     
                        <label for="" style="font-size: 14px;">@item.Itemname</label>
                    </label>

                </th>
                <td>@if(item.Itemtype){
                    <img src="~/images/veg-icon.svg" style="width:25px" alt="">
                }else
                {
                    <img src="~/images/non-veg-icon.svg" style="width:25px" alt="">
                }
            </td>
            <td>@item.Itemrate</td>
            <td>@item.Itemquantity</td>
            <td>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="flexSwitchCheckChecked" @(item.Isavailable ?
                                                                                                                        "checked" : "unchecked")>
                </div>
            </td>
            <td>
                <div class="d-flex justify-content-start w-100 pb-2 h-100">
                    <img src="~/images/pencil-square.svg" class="me-2" style="cursor: pointer;" onclick="EditItemGet(@item.Itemid)" alt="">
                    <img src="~/images/trash-fill.svg" onclick="deleteItemGet(@item.Itemid,@item.Categoryid)"
                        style="cursor: pointer;" alt="">

                </div>
            </td>
        </tr>
        }
        }
    </tbody>
</table>
<div class="bg-white w-100 d-flex justify-content-end align-items-center pe-2">
    <div class="d-flex justify-content-center align-items-center">
        <label for="" class="me-2">items per page:</label>
        <div class="dropdown mt-2 me-2">
            <select class="form-select form-select-lg mb-3 pageSize" aria-label=".form-select-lg example">
                <option value="1"  selected="@(Model.pageSize == 1 ? "selected" : null)">1</option>
                <option value="2"  selected="@(Model.pageSize == 2 ? "selected" : null)">2</option>
                <option value="3"  selected="@(Model.pageSize == 3 ? "selected" : null)">3</option>
                <option value="4"  selected="@(Model.pageSize == 4 ? "selected" : null)">4</option>
                <option value="5"  selected="@(Model.pageSize == 5 ? "selected" : null)">5</option>
                <option value="6"  selected="@(Model.pageSize == 6 ? "selected" : null)">6</option>
            </select>
        </div>
    </div>
    <label for="" class="me-2">Showing 1-5 of 13</label>
    <div class="d-flex mt-1">
        @if(Model.pageNumber > 1){
        <button type="button" class="btn btn-outline-dark btn2" onclick="loadTableData(selectedCategoryId,@Model.pageSize,@(Model.pageNumber-1))" style="padding: 6px;"><img src="" alt=""><img src="~/images/left-chevron-svgrepo-com.svg"
                style="width:25px" alt=""></button>
        }
        else{
        <button type="button" class="btn btn-outline-dark btn2" onclick="loadTableData(selectedCategoryId,@Model.pageSize,@(Model.pageNumber-1))" style="padding: 6px;" disabled><img src="" alt=""><img src="~/images/left-chevron-svgrepo-com.svg"
                style="width:25px" alt="" ></button>

        }
        @if(Model.pageNumber*Model.pageSize < Model.totalrecords){
        <button type="button" class="btn btn-outline-dark btn2 mb-2"  onclick="loadTableData(selectedCategoryId,@Model.pageSize,@(Model.pageNumber+1))" style="padding: 5.8px;"><img src="~/images/left-chevron-svgrepo-com.svg"
                style="width:25px;rotate: 180deg;" alt=""></button>
        }
        else{

        <button type="button" class="btn btn-outline-dark btn2 mb-2"  onclick="loadTableData(selectedCategoryId,@Model.pageSize,@(Model.pageNumber+1))" style="padding: 5.8px;" disabled><img src="~/images/left-chevron-svgrepo-com.svg"
                style="width:25px;rotate: 180deg;" alt="" ></button>
        }
    </div>
</div>
 
