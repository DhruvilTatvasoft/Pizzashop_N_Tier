@model ItemViewModel
<partial name="_ValidationScriptsPartial" />
<form id="AddItemForm">
    <div class="modal fade" id="exampleModalCenter3" tabindex="-1" role="dialog"
        aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="d-flex">
                    <h4 class="ms-3 mt-2 mb-0">Add New Menu Item</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="margin-left: auto;padding: 1%;width: 3%;" aria-label="Close"></button>
                </div>
                <div class="modal-body w-100 d-flex flex-column">
                    <div class="row w-100">
                        <div class="left col-8">
                            <div class="row d-flex justify-content-between model-row">
                                <div class="form-floating col-6">
                                    <select class="form-select model-select" asp-for="Categoryid"
                                        id="floatingSelect" aria-label="Floating label select example">
                                        @foreach (var c in Model.categories)
                                        {
                                            <option value="@c.Categoryid" selected>@c.Categoryname</option>
                                        }
                                    </select>
                                    <label for="floatingSelect" class="model-label">Category</label>
                                </div>
                                <div class="form-floating mb-3 col-6">
                                    <input type="text" class="form-control" id="floatingInput"
                                        asp-for="Itemname">
                                    <span asp-validation-for="Itemname" class="text-danger pt-2"></span>
                                    <label for="floatingInput" class="model-label">Name</label>
                                </div>
                            </div>
                            <div class="row d-flex justify-content-between  model-row">
                                <div class="col-3 w-25">
                                    <div class="form-floating col-3 w-100">
                                        <select class="form-select model-select model-select"
                                            asp-for="Itemtype" id="floatingSelect"
                                            aria-label="Floating label select example">
                                            <option value="true">veg</option>
                                            <option value="false">Non-veg</option>
                                        </select>
                                        <label for="floatingSelect" class="model-label">Item Type*</label>
                                    </div>
                                </div>
                                <div class="col-3 w-25">
                                    <div class="form-floating mb-3 col-3 w-100">
                                        <input type="number" class="form-control" id="floatingInput"
                                            placeholder="name@example.com" asp-for="Itemrate">
                                        <label for="floatingInput" class="model-label">Rate</label>
                                        <span asp-validation-for="Itemrate" class="text-danger pt-2"></span>
                                    </div>
                                </div>
                                <div class="col-3 w-25">
                                    <div class="form-floating mb-3 col-3 w-100">
                                        <input type="number" class="form-control" asp-for="Itemquantity"
                                            id="floatingInput" placeholder="name@example.com">
                                        <label for="floatingInput" class="model-label">Quantity</label>
                                        <span asp-validation-for="Itemquantity" class="text-danger pt-2"></span>
                                    </div>
                                </div>
                                <div class="col-3 w-25">
                                    <div class="form-floating mb-3 col-3 w-100">
                                        <select class="form-select model-select model-select" id="floatingSelect"
                                            asp-for="Unitid" aria-label="Floating label select example">
                                            @foreach (var u in Model.units)
                                            {
                                                <option value="@u.Unitid">@u.Unitname</option>
                                            }
                                        </select>
                                        <label for="floatingInput" class="model-label"
                                            asp-for="Unitid">unit</label>
                                    </div>
                                </div>
                            </div>
                            <div class="row d-flex justify-content-between">
                                <div class="col-3">
                                    <div class="form-check form-switch d-flex align-items-center w-100 h-100 pe-0">
                                        <input class="form-check-input me-2" type="checkbox" id="flexSwitchCheckDefault"
                                            asp-for="Isavailable"
                                            style="height:35px;width:65px;margin:0px;">
                                        <label class="form-check-label model-label "
                                            for="flexSwitchCheckDefault">Available</label>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div class="form-check form-switch d-flex align-items-center  w-100 h-100">
                                        <input class="form-check-input m-0 me-2" type="checkbox"
                                            id="flexSwitchCheckDefault" style="height:35px;width:65px;"
                                            asp-for="Isdefaulttax">
                                        <label class="form-check-label model-label" for="flexSwitchCheckDefault">Default
                                            Tax</label>
                                    </div>
                                </div>
                                <div class="col-3 p-0 ps-1">
                                    <div class="form-floating mb-3 col-3 w-100">
                                        <input type="number" class="form-control" id="floatingInput"
                                            placeholder="name@example.com" asp-for="Taxpercentage">
                                        <label for="floatingInput" class="model-label">tax percentage</label>
                                        <span asp-validation-for="Taxpercentage" class="text-danger pt-2"></span>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div class="form-floating mb-3 col-3 w-100">
                                        <input type="text" class="form-control" id="floatingInput"
                                            placeholder="name@example.com" asp-for="Shortcode">
                                        <label for="floatingInput" class="model-label">Short code</label>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 mb-2">
                                    <div class="form-floating">
                                        <textarea class="form-control" placeholder="Leave a comment here"
                                            id="floatingTextarea2" style="height: 100px"
                                            asp-for="Description"></textarea>
                                        <label for="floatingTextarea2">description</label>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-12">
                                    <div class="form-floating">
                                        <div class="container-fluid" style="padding: 0; border: 1px solid #dee2e6; border-radius: 0%;">
                                            <input type="file" asp-for="@Model.ImagePath" id="ItemImage" style="display: none;" onchange="displayImageName(event)" />
                                            <label for="ItemImage" class="fileUploadLabel" style="width: 100%; cursor: pointer;">
                                                <div class="d-flex justify-content-center align-items-center p-4" style="width: 100%;">
                                                    <img id="uploadIcon" src="/images/icons8-cloud-upload-50.png" style="margin-right: 10px;width:30px;height : 30px;">
                                                    <div id="imageText" style="text-align: center;">Drag and drop or Browse Files</div>
                                                </div>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="right col-4 pe-1" style="background-color: antiquewhite;">
                            <div class="dropdown mt-2 me-2">
                                <select class="form-select form-select-lg mb-1" id="modifier-group"
                                    onchange="getModifier('exampleModalCenter3')" style="font-size: 80%;"
                                    aria-label=".form-select-lg example">
                                    <option value="1"><label for="" class="fs-2">Select Modifier
                                            Groups(s)</label>
                                    </option>
                                    @foreach (var m in @Model.modifiergroups)
                                    {
                                        <option value="@m.Modifiergroupid">@m.Modifiergroupname</option>
                                    }
                                </select>
                            </div>
                              <div class="loadModifiers p-3" style="height: 386px;overflow-y: auto;"></div>
                            <input type="hidden" name="modifiername" id="modifierData">
                        </div>
                    </div>
                </div>
                <div class="pb-3 ps-3">
                    <button class="btn btn-primary" type="submit">Submit</button>
                    <button class="btn btn-outline-primary closeBTN" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
    </div>
</form>
<script>
    function formDataToJsonString(formData) {
        let object = {};
        formData.forEach((value, key) => {
            if (object[key]) {
                object[key] = [].concat(object[key], value);
            } else {
                object[key] = value;
            }
        });
        return JSON.stringify(object);
    }

    function displayImageName(event) {
        const file = event.target.files[0]; 
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const previewImage = document.getElementById('uploadIcon');
                const imagePreview = document.getElementById('imageText');
                previewImage.src = e.target.result;
            };
            reader.readAsDataURL(file);
            const fileName = document.getElementById('fileName');
            document.getElementById('imageText').textContent = file.name; 
        }
    }
    if (!window.addItemFormHandlerInitialized) {
        window.addItemFormHandlerInitialized = true;
        $(document).on('submit', '#AddItemForm', function(e) {
            e.preventDefault();
            e.stopImmediatePropagation();
            if ($(this).valid()) {
                var form = $(this);
                var data = new FormData(this);
                var modifierData = [];
                var filePath = $("#ItemImage")[0].value;
                if(filePath!= null || filePath != "") {
                var extension = filePath.substring(filePath.lastIndexOf(".") + 1, filePath.length).toLowerCase();
                var validFilesTypes = ["jpg","png","svg","jpeg"];
                var isValidFile = validFilesTypes.includes(extension);
                if (!isValidFile) {
                toastr.error("Please select a valid image file type");
                return ;
                }
            }
                
                $(".modifier-group-item").each(function(index) {
                    let modifierGroupId = $(this).find(".modifiergroupID").val();
                    let minValue = $(this).find(".min_value").val();
                    let maxValue = $(this).find(".max_value").val();
                    
                    if (modifierGroupId) {
                        modifierData.push({
                            ModifiergroupId: modifierGroupId,
                            min_value: minValue || 0,
                            max_value: maxValue || 0
                        });
                    }
                });
                
                data.append("payload", JSON.stringify(modifierData));
                
                $.ajax({
                    url: form.attr('action') || "/Menu/AddNewItem",
                    method: 'POST',
                    data: data,
                    contentType: false,
                    processData: false,
                    success: function(response) {
                        if (response.error) {
                            toastr.error(response.error);
                        } else {
                            $('#exampleModalCenter3').modal('hide');
                            toastr.success(response.success);
                            if (typeof loadTableData === 'function') {
                                loadTableData(response.categoryid, $(".pageSize").val(), 1);
                                selectedCategoryId = response.categoryid;
                            }
                        }
                    },
                    error: function(xhr) {
                        try {
                            var err = JSON.parse(xhr.responseText);
                            toastr.error(err.error || 'Error adding item');
                        } catch(e) {
                            toastr.error('An unexpected error occurred');
                        }
                    }
                });
            }
        });
    }
</script>