@{
    Layout = "~/Views/Shared/_Sidebar&navbar.cshtml";

    ViewData["Title"] = "Menu Page";

}
@model MenuModel

<link rel="stylesheet" href="~/css/menu.css">
<div class="container-fluid w-100 h-100 p-0">
    <div id="nav-sidebar"></div>
    <div class="row p-0 h-100 d-flex">
        <div class="content pt-3 w-100 h-100">
            <div class="header d-flex align-items-center justify-content-start mb-4 d-flex">
                <h1>Menu</h1>
            </div>
            <div class="form-container shadow">
                <div>
                    <div class="navpanel w-100 mb-2">
                        <button type="submit" class="h-100 item" style="width: 10%;font-size: 15px;"
                            onclick="loadcategoryItemPage()"><img src="~/images/list-ul copy.svg" class="p-2 itemimage"
                                alt="">Items</button>
                        <button type="submit" class="h-100 mod" style="width: 10%;font-size: 15px;"
                            onclick="loadModifierPage()"><img src="~/images/ui-radios-grid.svg" class="p-2"
                                alt="">Modifiers</button>
                    </div>
                </div>
                <div class="d-flex w-100 h-100" id="menu-container">

                    <div class="menusidebar h-100 "></div>
                    <div class="menubody bg-white h-100"></div>
                    <div id="deletemodel"></div>
                    <div id="AddItemModelDiv"></div>
                    <div id="editItemModel"></div>
                </div>
            </div>
        </div>
    </div>
    <script>
        var selectedCategoryId = 0;
        $("document").ready(function () {
            loadCategories();
            loadItemData();
            $('.item').addClass('active');
            $('.sidebar ul li').removeClass('active-class');
            $('.menu').addClass('active-class')
        });
        function loadcategoryItemPage() {
            $('.mod').removeClass('active');
            $('.item').addClass('active');
            $('.item img').attr("src", "/images/list-ul copy.svg")
            $('.mod img').attr("src", "/images/ui-radios-grid.svg")
            loadCategories();
            loadItemData();
        }
        function loadCategories() {
            $.ajax({
                url: '@Url.Action("CategoriesData", "Menu")',
                type: "GET",
                cache: false,
                success: function (data) {
                    $(".menusidebar").html(data);

                }
            });
        };
        function loadTableData(categoryid, pageSize, pageNumber) {
            $('[id^="selectedCat_"]').removeClass("active2");
            $('#selectedCat_' + categoryid).addClass("active2");
            $.ajax({
                url: '@Url.Action("ItemsData", "Menu")',
                data: { categoryid: categoryid, pageSize: pageSize, pageNumber: pageNumber },
                method: 'GET',
                success: function (data) {
                    $(".table-container").html(data);
                    selectedCategoryId = categoryid

                }
            });
        }
        function loadItemData(categoryId) {
            $.ajax({
                url: '@Url.Action("LoadItemPage", "Menu")',
                type: "GET",
                data: { categoryId: categoryId },
                cache: false,
                success: function (data) {
                    $(".menubody").html(data);
                }
            });
        };

        function deleteItemsGet() {

            if([...document.querySelectorAll(".checkedItems:checked")].map(x => parseInt(x.value, 10)).length < 1) {
                toastr.error("Please select items to delete");
                return;
            }
            $.ajax({
                url: '@Url.Action("deleteItem", "Menu")',
                type: "GET",
                success: function (data) {
                    $('#deletemodel').html(data);
                    $('#exampleModalCenter8').modal('show');
                    $('.singleItemDelete').css("display", "none");
                    $('.MultipleItemsDelete').css("display", "block");
                    $('.categoryDelete').css("display", "none");
                    $('h5').html("Are you sure you want to delete this items?")
                    var selectedItems = [...document.querySelectorAll(".checkedItems:checked")].map(x => parseInt(x.value, 10));
                    $('#itemid_hidden').val(selectedItems);
                }
            });
        };

        function DeleteMultipleItems() {
            var selectedItems = $("#itemid_hidden").val();
            selectedItems = selectedItems.split(',').map(Number);
            var categoryId = document.getElementById("categoryid_hidden").value;
            $.ajax({
                url: '@Url.Action("DeleteItems", "Menu")',
                data: { selectedItems: selectedItems, categoryId: categoryId },
                method: 'POST',
                success: function (data) {
                    loadTableData(selectedCategoryId, $(".pageSize").val(), 1);
                    toastr.success(data.success);
                }

            });
        };
        function deleteItemGet(itemid, Categoryid) {
            console.log("clicked");
            console.log(itemid);
            $.ajax({
                url: '@Url.Action("deleteItem", "Menu")',
                type: "GET",
                data: { itemid: itemid },
                success: function (data) {
                    $('#deletemodel').html(data);
                    $('#exampleModalCenter8').modal('show');
                    $('.singleItemDelete').css("display", "block");
                    $('.MultipleItemsDelete').css("display", "none");
                    $('.categoryDelete').css("display", "none");
                    $('#itemid_hidden').val(itemid);
                    $('#categoryid_hidden').val(Categoryid);
                }
            });
        };

        function deleteItemPost() {
            console.log("clicked");
            var itemid = $('#itemid_hidden').val();
            var categoryId = $('#categoryid_hidden').val();
            console.log(categoryId)
            $.ajax({
                url: '@Url.Action("deleteItem", "Menu")',
                type: "POST",
                data: { itemid: itemid, categoryId: categoryId },
                success: function (data) {
                    $('.table-container').html(data);
                    loadTableData(data.categoryid, $(".pageSize").val(), 1);
                    selectedCategoryId = data.categoryId;
                    toastr.success(data.succes);
                }
            });

        };

        function openAddItemModal() {
            console.log("model opened");
            $.ajax({
                url: '@Url.Action("OpenAddItemModel", "Menu")',
                method: 'GET',
                success: function (data) {
                    console.log(data);
                    $("#AddItemModelDiv").html(data);
                    $("#exampleModalCenter3").modal('show');
                }
            });
        }



        function EditItemGet(itemid) {
            $.ajax({
                url: '@Url.Action("EditItemGet", "Menu")',
                type: 'GET',
                data: { itemId: itemid },
                success: function (data) {
                    $('#editItemModel').html(data);
                    $('#ModelForEditItem').modal('show');
                }
            });
        }

    @* -------------------------------------ModifierPage-------------------------------------------- *@

            function loadModifierPage() {
                loadModifierGroups();
                loadModifiersData(1);
                $('.item').removeClass('active');
                $('.mod').addClass('active');
                $('.item img').attr("src", "/images/list-ul.svg")
                $('.mod img').attr("src", "/images/ui-radios-grid copy.svg")

            }

        function loadModifierGroups() {
            console.log("Loading Modifier Groups...");
            $.ajax({
                url: '@Url.Action("getModifierGroups", "Menu")',
                method: 'GET',
                data: { partialViewName: "_modifierGroupsPartial" },
                success: function (response) {
                    $(".menusidebar").html(response);
                },
                error: function (xhr, status, error) {
                    console.error('Error loading modifier groups:', error);
                }
            });
        }

        function loadModifiersForModifierGroup(modifierGroupId, pageNumber) {
            $("#ModifierGroupList li").removeClass("active2");
            $("#selectedModifierGroup_" + modifierGroupId).addClass("active2");
            var pageSize = $('.pagesize').val();
            $.ajax({
                url: '/Menu/getModifiersForModifierGp',
                type: 'GET',
                data: { modifierGroupId: modifierGroupId, pageNumber: pageNumber, pageSize: pageSize },
                success: function (response) {
                    $(".table-container").html(response);
                },
                error: function (xhr, status, error) {
                    console.error('Error fetching modifiers:', error);
                }
            });
        }

        function openAddModifierModal() {
            $.ajax({
                url: "@Url.Action("getAddEditModel", "Menu")",
                type: "GET",
                success: function (data) {
                    $('.addEditModelContainer').html(data);
                    $('#addNewModifier').modal('show');
                    $("#saveNewModifier").attr("style", "display:block");
                    $("#updateModifier").attr("style", "display:none");
                }
            });
        }
        function loadModifiersData(modifierGroupId) {
            $.ajax({
                url: '/Menu/LoadModifiersPage',
                type: 'GET',
                data: { modifierGroupId: modifierGroupId },
                success: function (response) {
                    $(".menubody").html(response);
                    console.log("modifier page loaded");
                },
                error: function (xhr, status, error) {
                    console.error('Error fetching modifiers data:', error);
                }
            });
        }

        $(document).on("submit", "#AddNewModifier", function (e) {
            e.preventDefault();
            var $form = $(this);
            if ($form.data('submitting')) return;
            $form.data('submitting', true);
            if ($(this).valid()) {
                var data = new FormData(this);
                var Action = $(document.activeElement).data('action');
                var selectedModifierGroup = $('#modifierGroup').val();
                let = "";
                if (Action === "Add") {
                    url = '@Url.Action("AddNewModifier", "Menu")';
                    data.append("modifier.Modifiergroupid", selectedModifierGroup)
                }
                else {
                    url = '@Url.Action("EditmodifierPost", "Menu")';
                    data.append("modifier.Modifiergroupid", selectedModifierGroup)
                    data.append("modifier.Modifierid", $("#modifierIdForUpdate").val())
                }
                for (const pair of data.entries()) {
                    console.log(pair[0], pair[1]);
                }
                console.log("url: " + url);


                console.log("value of selected modifier group is " + selectedModifierGroup);
                $.ajax({
                    url: url,
                    type: 'POST',
                    data: data,
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        $(".cancelBtn").click();
                        if (data.success) {
                            toastr.success(data.success);
                            console.log("data should load for modifiergroup : " + selectedModifierGroup);
                            loadModifiersForModifierGroup(data.modifierGroupId, 1);

                        }
                        else {
                            toastr.error(data.error);
                            loadModifiersForModifierGroup(data.modifierGroupId, 1);

                        }
                    }
                });
            }
        });




    </script>