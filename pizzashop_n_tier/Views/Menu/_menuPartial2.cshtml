@model ItemModel
<h3 class="p-3 header-text">Items</h3>
<div class="d-flex justify-content-end w-100 ">

    <div class="me-3">
        <input type="email" class="form-control h-100 " onkeyup="searchItem()" asp-for="searchItemName"
            id="searchedItem" placeholder="Search">
    </div>

    <button class="btn btn-outline-secondary me-2" onclick='deleteItemsGet(@Model.categoryId)'><img
            src="~/images/trash-fill.svg" style="cursor: pointer;" alt=""></button>

    <button class="btn btn-primary me-3 add-item-modifier" type="button" onclick="openAddItemModal()">+ New
        Item</button>
    <input type="text" id="categoryid_hidden" value="@Model.categoryId" hidden>
</div>
<div class="tbl m-3 table-container"></div>

<div id="AddItemModelDiv">
</div>
<script>
    $("document").ready(() => {
        loadTableData(10, $(".pageSize").val(), 1);
        console.log("page size is : " + $(".pageSize").val())
    })
    function searchItem() {
        var SearchedItem = $('#searchedItem').val();
        if (SearchedItem.length > 2) {
            $.ajax({
                url: '@Url.Action("SearchItem", "Menu")',
                method: 'POST',
                data: { searchedItem: SearchedItem, categoryId: selectedCategoryId },
                success: function (data) {
                    console.log(data);
                    $(".table-container").html(data);
                }
            });
        }
        else {
            loadTableData(selectedCategoryId, $(".pageSize").val(), 1)
        }
    };

    function openAddItemModal() {
        console.log("model opened");
        $.ajax({
            url: '@Url.Action("OpenAddItemModel", "Menu")',
            method: 'GET',
            success: function (data) {
                console.log(data);
                $("#AddItemModelDiv").html(data);
                $("#exampleModalCenter3").modal('show');
            }
        });
    }
</script>
