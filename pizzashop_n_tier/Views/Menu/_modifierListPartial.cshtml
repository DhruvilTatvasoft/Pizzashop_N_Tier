@{
    Layout = "";
}
@model ItemModel
<input type="hidden" id="modifierGroupId"asp-for="@Model.modifierGroupId">
<input type="hidden" id="pageNumber"asp-for="@Model.pageNumber">
<table class="table">
    <thead>
        <tr>
            <th scope="col">
                <input class="form-check-input checkedItems me-1" id="masterCheck" type="checkbox" />
                <label class="form-check-label" for="flexCheckDefault">
                    <label for="" style="font-size: 14px;">Name</label>
                </label>
            </th>
            <th scope="col">
                <div class="form-check">
                    <label class="form-check-label" for="flexCheckDefault">
                        Unit
                    </label>
                </div>
            </th>
            <th scope="col">Rate</th>
            <th scope="col">Quantity</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>

        @if (Model.modifiers.Count() <= 0)
        {
            <td colspan="5" class="text-center"><img src="~/images/exclamation-circle-fill.svg" class="p-3" alt="">No Orders
                Found</td>
           
        }
        else
        {
            @foreach (var modifier in Model.modifiers)
            {
                <tr>
                    <td scope="row">
                        <input class="form-check-input IsModifierChecked" type="checkbox" value="@modifier.Modifierid" />
                        <label class="form-check-label" for="flexCheckDefault">
                            <label for="" style="font-size: 14px;">@modifier.Modifiername</label>
                        </label>

                    </td>
                    <td>@modifier.Unit.Shortname</td>
                    <td>@modifier.Modifierrate</td>
                    <td>@modifier.Modifierquantity</td>
                    <td data-lastcolumn="L">
                        <div class="d-flex justify-content-start w-100 pb-2 h-100">
                            <img src="~/images/pencil-square.svg" class="me-2" alt=""
                                onclick="OpenEditModifierModel(@modifier.Modifierid,@modifier.Modifiergroupid)">
                            <img src="~/images/trash-fill.svg"
                                onclick="OpenDeleteModifierModal(@modifier.Modifierid,@modifier.Modifiergroupid)"
                                style="cursor: pointer;" alt="">
                        </div>
                    </td>
                </tr>
            }
        }

    </tbody>
</table>

<div class="bg-white w-100 d-flex justify-content-end align-items-center pe-2">
    <div class="d-flex justify-content-center align-items-center">
        <label for="" class="me-2">items per page:</label>
        <div class="dropdown mt-2 me-2">
            <select class="form-select form-select-lg mb-3 pagesize"
                onchange="loadModifiersForModifierGroup(@Model.modifierGroupId,@Model.pageNumber)"
                aria-label=".form-select-lg example">
                <option value="1" selected="@(Model.pageSize == 1 ? "selected" : null)" >1</option>
                <option value="2" selected="@(Model.pageSize == 2 ? "selected" : null)" >2</option>
                <option value="3" selected="@(Model.pageSize == 3 ? "selected" : null)" >3</option>
                <option value="4" selected="@(Model.pageSize == 4 ? "selected" : null)">4</option>
                <option value="5" selected="@(Model.pageSize == 5 ? "selected" : null)">5</option>
                <option value="6" selected="@(Model.pageSize == 6 ? "selected" : null)">6</option>
            </select>
        </div>
    </div>
    <label for="" class="me-2">Showing 1-5 of 13</label>
    <div class="d-flex mt-1">
        @if (Model.pageNumber > 1)
        {
            <button type="button" class="btn btn-outline-dark btn2" style="padding: 6px;" onclick="loadModifiersForModifierGroup(@Model.modifierGroupId,@(Model.pageNumber-1))"><img src="" alt=""><img src="~/images/left-chevron-svgrepo-com.svg"
                    style="width:25px" alt=""></button>
        }
        else
        {
            <button type="button" class="btn btn-outline-dark btn2" style="padding: 6px;" disabled><img src="" alt=""><img src="~/images/left-chevron-svgrepo-com.svg"style="width:25px" alt=""></button>

        }
        @if (Model.pageNumber * Model.pageSize < Model.totalrecords)
        {
            <button type="button" class="btn btn-outline-dark btn2 mb-2" style="padding: 5.8px;" onclick="loadModifiersForModifierGroup(@Model.modifierGroupId,@(Model.pageNumber+1))"><img src="~/images/left-chevron-svgrepo-com.svg"style="width:25px;rotate: 180deg;" alt=""></button>
        }
        else
        {
            <button type="button" class="btn btn-outline-dark btn2 mb-2" style="padding: 5.8px;" disabled><img src="~/images/left-chevron-svgrepo-com.svg"
                    style="width:25px;rotate: 180deg;" alt=""></button>
        }
        
    </div>
</div>

<script>
    function initializeModifierCheckboxes() {
        const masterCheckbox = document.getElementById("masterCheck");

        if (masterCheckbox) {
            masterCheckbox.addEventListener("change", () => {
                const subchecks = document.querySelectorAll(".IsModifierChecked");
                subchecks.forEach((checkbox) => {
                    checkbox.checked = masterCheckbox.checked;
                });
            });
        }

        document.querySelectorAll(".IsModifierChecked").forEach((checkbox) => {
            checkbox.addEventListener("change", () => {
                const subchecks = document.querySelectorAll(".IsModifierChecked");
                const checked = document.querySelectorAll(".IsModifierChecked:checked");
                const master = document.getElementById("masterCheck");
                if (master) {
                    master.checked = (subchecks.length === checked.length);
                }
            });
        });
    }

    // Call this function when the DOM is ready
    document.addEventListener("DOMContentLoaded", initializeModifierCheckboxes);
</script>


