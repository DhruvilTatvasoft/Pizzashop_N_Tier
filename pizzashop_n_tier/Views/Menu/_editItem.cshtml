@model ItemViewModel
<partial name="_ValidationScriptsPartial" />
<form id="EditItemForm">
   <div class="modal fade" id="ModelForEditItem" tabindex="-1" role="dialog"
      aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered" role="document">
         <div class="modal-content">
            <div class="d-flex">
               <h4 class="ms-3 mt-2 mb-0">Edit Menu Item</h4>
               <input type="hidden" asp-for="itemid">
               <button type="button" class="btn-close" data-bs-dismiss="modal"
                  style="margin-left: auto;padding: 1%;width: 3%;" aria-label="Close"></button>
            </div>
            <div class="modal-body w-100 d-flex flex-column">
               <div class="row w-100">
                  <div class="left col-8">
                     <div class="row d-flex justify-content-between model-row">
                        <div class="form-floating col-6">
                           <select class="form-select model-select" asp-for="Categoryid"
                              id="floatingSelect" aria-label="Floating label select example">
                              @foreach (var c in Model.categories)
                              {
                              if(Model.Categoryid == c.Categoryid){
                              <option value="@c.Categoryid" selected>@c.Categoryname</option>
                              }
                              else{
                              <option value="@c.Categoryid" >@c.Categoryname</option>
                              }
                              }
                           </select>
                           <label for="floatingSelect" class="model-label">Category</label>
                        </div>
                        <div class="form-floating mb-3 col-6">
                           <input type="text" class="form-control" id="floatingInput"
                              asp-for="Itemname">
                           <span asp-validation-for="Itemname" class="text-danger pt-2"></span>
                           <label for="floatingInput" class="model-label">Name</label>
                        </div>
                     </div>
                     <div class="row d-flex justify-content-between  model-row">
                        <div class="col-3 w-25">
                           <div class="form-floating col-3 w-100">
                              <select class="form-select model-select model-select"
                                 asp-for="Itemtype" id="floatingSelect"
                                 aria-label="Floating label select example">
                                 <option value="true">veg</option>
                                 <option value="false">Non-veg</option>
                              </select>
                              <label for="floatingSelect" class="model-label">Item Type*</label>
                           </div>
                        </div>
                        <div class="col-3 w-25">
                           <div class="form-floating mb-3 col-3 w-100">
                              <input type="number" class="form-control" id="floatingInput"
                                 placeholder="name@example.com" asp-for="Itemrate" value="@Model.Itemrate">
                              <label for="floatingInput" class="model-label">Rate</label>
                              <span asp-validation-for="Itemrate" class="text-danger pt-2"></span>
                           </div>
                        </div>
                        <div class="col-3 w-25">
                           <div class="form-floating mb-3 col-3 w-100">
                              <input type="number" class="form-control" asp-for="Itemquantity"
                                 id="floatingInput" placeholder="name@example.com">
                              <label for="floatingInput" class="model-label">Quantity</label>
                              <span asp-validation-for="Itemquantity" class="text-danger pt-2"></span>
                           </div>
                        </div>
                        <div class="col-3 w-25">
                           <div class="form-floating mb-3 col-3 w-100">
                              <select class="form-select model-select model-select" id="floatingSelect"
                                 asp-for="Unitid" aria-label="Floating label select example">
                                 @foreach (var u in Model.units)
                                 {
                                 <option value="@u.Unitid">@u.Unitname</option>
                                 }
                              </select>
                              <label for="floatingInput" class="model-label"
                                 asp-for="Unitid">unit</label>
                           </div>
                        </div>
                        
                     </div>
                     <div class="row d-flex justify-content-between">
                        <div class="col-3">
                           <div class="form-check form-switch d-flex align-items-center w-100 h-100 pe-0">
                              @if(Model.Isavailable){
                              <input class="form-check-input me-2" type="checkbox" id="flexSwitchCheckDefault"
                                 asp-for="Isavailable"
                                 style="height:35px;width:65px;margin:0px;" checked>
                              }
                              else{
                              <input class="form-check-input me-2" type="checkbox" id="flexSwitchCheckDefault"
                                 asp-for="Isavailable"
                                 style="height:35px;width:65px;margin:0px;">
                              }
                              <label class="form-check-label model-label "
                                 for="flexSwitchCheckDefault">Available</label>
                           </div>
                        </div>
                        <div class="col-3">
                           <div class="form-check form-switch d-flex align-items-center  w-100 h-100">
                              @if(Model.Isdefaulttax){
                              <input class="form-check-input m-0 me-2" type="checkbox"
                                 id="flexSwitchCheckDefault" style="height:35px;width:65px;"
                                 asp-for="Isdefaulttax" checked>
                              }
                              else{
                              <input class="form-check-input m-0 me-2" type="checkbox"
                                 id="flexSwitchCheckDefault" style="height:35px;width:65px;"
                                 asp-for="Isdefaulttax" >
                              }
                              <label class="form-check-label model-label" for="flexSwitchCheckDefault">Default
                              Tax</label>
                           </div>
                        </div>
                        <div class="col-3 p-0 ps-1">
                           <div class="form-floating mb-3 col-3 w-100">
                              <input type="number" class="form-control" id="floatingInput"
                                 placeholder="name@example.com" asp-for="Taxpercentage">
                              <label for="floatingInput" class="model-label">tax percentage</label>
                              <span asp-validation-for="Taxpercentage" class="text-danger pt-2"></span>
                           </div>
                        </div>
                        <div class="col-3">
                           <div class="form-floating mb-3 col-3 w-100">
                              <input type="text" class="form-control" id="floatingInput"
                                 placeholder="name@example.com" asp-for="Shortcode">
                              <label for="floatingInput" class="model-label">Short code</label>
                           </div>
                        </div>
                     </div>
                     <div class="row">
                        <div class="col-12 mb-2">
                           <div class="form-floating">
                              <textarea class="form-control" placeholder="Leave a comment here"
                                 id="floatingTextarea2" style="height: 100px"
                                 asp-for="Description"></textarea>
                              <label for="floatingTextarea2">description</label>
                           </div>
                        </div>
                     </div>
                     <div class="row mb-2">
                        <div class="col-12">
                           <div class="form-floating">
                              <div class="container-fluid"
                                 style="padding: 0%;border: 1px solid #dee2e6;border-radius: 0%;">
                                 <input type="file" asp-for="ImagePath" id="fileUpload1"
                                    hidden>
                                 <div class="d-flex justify-content-center p-4 align-items-center">
                                    <label for="fileUpload1" class="fileUploadLabel">
                                    <img src="/images/icons8-cloud-upload-50.png"
                                       style="margin-left: 47%;margin-top:2%;">
                                    </label>
                                    <div style="text-align: center;" class="ms-5">Drag and drop or Browse
                                       Files @Model.ModifierModels.Count
                                    </div>
                                 </div>
                              </div>
                           </div>
                        </div>
                     </div>
                  </div>
                  <div class="right col-4 pe-1" style="background-color: antiquewhite;">
                     <div class="dropdown mt-2 me-2">
                        <select class="form-select form-select-lg mb-1" id="modifier-group"
                           onchange="getModifier()" style="font-size: 80%;"
                           aria-label=".form-select-lg example">
                           <option value="0"><label for="" class="fs-2">Select Modifier
                              Groups(s)</label>
                           </option>
                           @foreach (var m in @Model.modifiergroups)
                           {
                           <option value="@m.Modifiergroupid">@m.Modifiergroupname</option>
                           }
                        </select>
                     </div>
                     <div class="loadModifiers p-3 " style="height: 386px;overflow-y: auto;">
                        @foreach(var modifierModel in @Model.ModifierModels){
                        <div class="modifier-group-item" id="modifiergroup_@modifierModel.ModifiergroupId">
                           <div class="d-flex  pe-3 pt-1 mb-2" >
                              <label class="fw-bold">@modifierModel.mg.Modifiergroupname  </label>
                              @* <label>@modifierModel.modifiers.Count</label> *@
                              <img src="~/images/trash-fill.svg" style="margin-left:auto;cursor:pointer;"
                                 onclick="deleteModifierGroup(@modifierModel.ModifiergroupId)" alt="">
                           </div>
                           <input  class="modifiergroupID" value="@modifierModel.ModifiergroupId" hidden>
                           <div class="d-flex">
                              <select class="form-select form-select-lg mb-3 w-25 min_value"  style="font-size:0.75rem"
                                 aria-label=".form-select-lg example">
                                 @if(modifierModel.modifiers.Count>0){
                                 @for(int i=1;i<=modifierModel.modifiers.Count;i++){
                                 <option value="@i">@i</option>
                                 }
                                 }
                                 else{
                                 <option value="0">0</option>
                                 }                                                  
                              </select>
                              <select class="form-select form-select-lg mb-3 w-25 max_value" id="modifiergroupid_@modifierModel.ModifiergroupId"   style="margin-left:auto;font-size: 0.75rem;"
                                 aria-label=".form-select-lg example">
                                 @if(modifierModel.modifiers.Count>0){
                                 @for(int i=1;i<=modifierModel.modifiers.Count;i++){
                                 <option value="@i">@i</option>
                                 }
                                 }
                                 else{
                                 <option value="0">0</option>
                                 }
                              </select>
                           </div>
                           <ul class="">
                              @if(modifierModel.modifiers.Count <= 0){
                              <div class="d-flex align-items-center mt-0 ps-4">
                                 <img src="~/images/exclamation-circle-fill.svg" class="pe-3 pt-0" alt="">
                                 <label for="" class="pt-0">No records found</label>
                              </div>
                              }
                              else{
                              @foreach (var m in @modifierModel.modifiers)
                              {
                              <div class="d-flex justify-content-between">
                                 <li class="pb-1 pt-1 w-75" style="list-style-type: circle;">@m.Modifiername</li>
                                 <li class="pb-1 pt-1 w-25">@m.Modifierrate</li>
                              </div>
                              }
                              }
                           </ul>
                        </div>
                        }
                     </div>
                     <input type="hidden" name="modifiername" id="modifierData">
                  </div>
               </div>
            </div>
            <div class="pb-3 ps-3">
               <button class="btn btn-primary" type="submit">Save</button>
               <button class="btn btn-outline-primary closeBTN" data-bs-dismiss="modal">Cancel</button>
            </div>
         </div>
      </div>
   </div>
   </div>
</form>

<script>
   function deleteModifierGroup(id) {
      var temp = "#modifiergroup_" + id;
      document.querySelector(temp).remove();
      $("#modifier-group").val("Select Modifier Group(s)");
   }

function getModifier() {
      if($('#modifier-group').val() != 0){
      console.log("changed");
      var temporaryId = "#modifiergroup_" + $('#modifier-group').val();
      console.log(temporaryId);
      var modifiergroup = document.querySelector(temporaryId);
      if (modifiergroup == null) {
          $.ajax({
              url: '/Menu/getModifiers',
              type: 'GET',
              data: { modifiergroupid: $('#modifier-group').val() },
              success: function (data) {
                  $(".loadModifiers").append(data);
              }
          });
      }
      }
   } 
    if (!window.editItemFormHandlerInitialized) {
        window.editItemFormHandlerInitialized = true;
        
        $(document).on('submit', '#EditItemForm', function(e) {
            e.preventDefault();
            e.stopImmediatePropagation();

            var form = $(this);
            var data = new FormData(this);
            var modifierData = [];
            
            $(".modifier-group-item").each(function(index) {
                let modifierGroupId = $(this).find(".modifiergroupID").val();
                let minValue = $(this).find(".min_value").val();
                let maxValue = $(this).find(".max_value").val();
                
                if (modifierGroupId) {
                    modifierData.push({
                        ModifiergroupId: modifierGroupId,
                        min_value: minValue || 0,
                        max_value: maxValue || 0
                    });
                }
            });
            data.append("payload", JSON.stringify(modifierData));
            $.ajax({
                url: form.attr('action') || '@Url.Action("PostEditItem","Menu")',
                type: 'POST',
                data: data,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.success) {
                        $('#ModelForEditItem').modal('hide');
                        toastr.success(response.success || "Item updated successfully");
                        loadTableData(response.categoryid)
                        
                    } else if (response.error) {
                        toastr.error(response.error);
                    }
                },
                error: function(xhr) {
                    try {
                        var err = JSON.parse(xhr.responseText);
                        toastr.error(err.error || 'Error updating item');
                    } catch(e) {
                        toastr.error('An unexpected error occurred');
                    }
                }
            });
            return false;
        });
    }
</script>
