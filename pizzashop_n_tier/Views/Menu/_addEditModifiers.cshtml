@model ModifierModel
<form id="AddNewModifier">
        <div class="modal fade" id="addNewModifier" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
            aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header" style="border:none;">
                        <h5 class="modal-title" id="exampleModalLabel">Add New Modifier</h5>
                        <button type="button" class="close" style="margin-left: auto; border: none; background: none;"
                            aria-label="Close" data-bs-dismiss="modal">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="row">

                            <div class="mb-3 col-md-6">
                            <div class="form-floating">
                            <label for="" class="form-label"
                                style="font-size: 61%;top: -12px;left: -1px;">Select Modifier Group(s)*</label>
                            <input type="hidden" asp-for="@Model.Modifierid">
                                <select class="form-select" id="modifierGroup" asp-for="Modifiergroupid">
                                    <option >Select Modifier Group(s)</option>
                                    @foreach (var modifiergroup in @Model.modifiergroups)
                                    {
                                    @if(@Model.modifier != null && modifiergroup.Modifiergroupid == @Model.modifier.Modifiergroupid){
                                        <option value="@modifiergroup.Modifiergroupid" selected>@modifiergroup.Modifiergroupname
                                        </option>
                                    }
                                    else{
                                        <option value="@modifiergroup.Modifiergroupid">@modifiergroup.Modifiergroupname
                                        </option>
                                    }
                                    }
                                </select> 
                                <span asp-validation-for="Modifiergroupid" class="text-danger"></span>                         
                            </div>
                        </div>
                            <div class="mb-3 col-md-6">
                            <div class="form-floating">
                            <label for="" class="form-label"
                                style="font-size: 61%;top: -12px;left: -1px;">Name*</label>
                            <input type="text" class="form-control" asp-for="Modifiername"
                                    id="modifierName" placeholder="Name*">
                                <input type="number" id="modifierIdForUpdate" hidden>
                            <span asp-validation-for="Modifiername" class="text-danger"></span>
                            </div>
                        </div>
                        </div>

                        <div class="row">

                            <div class="mb-3 col-md-4">
                            <div class="form-floating">
                            <label for="" class="form-label"
                                style="font-size: 61%;top: -12px;left: -1px;">Quantity*</label>
                            <input type="number" class="form-control" id="modifierRate"
                                    asp-for="Modifierquantity" placeholder="Rate*">
                            </div>
                            <span asp-validation-for="Modifierquantity" class="text-danger"></span>
                            
                        </div>
                            <div class="mb-3 col-md-4">
                            <div class="form-floating">
                            <label for="" class="form-label"
                                style="font-size: 61%;top: -12px;left: -1px;">Rate*</label>
                            <input type="number" class="form-control" id="modifierRate"
                                    asp-for="Modifierrate" placeholder="Rate*">
                            <span asp-validation-for="Modifierrate" class="text-danger"></span>
                            </div>
                        </div>

                           

                            <div class="mb-3 col-md-4">
                            <div class="form-floating">
                            <label for="" class="form-label"
                                style="font-size: 61%;top: -12px;left: -1px;">Unit*</label>

                            <select class="form-control" id="modifierUnit" style="font-size:85%;" asp-for="Unitid">
                                    <option>Select a unit</option>
                                    @foreach (var unit in @Model.units)
                                    {
                                     @if(@Model.modifier != null && unit.Unitid == @Model.modifier.Unitid){
                                        <option value="@unit.Unitid" selected>@unit.Unitname</option>
                                     }
                                     else{
                                        <option value="@unit.Unitid">@unit.Unitname</option>
                                     }
                                    }
                                </select>
                                <span asp-validation-for="Unitid" class="text-danger"></span>
                            
                            </div>
                        </div>
                        </div>
                        <div class="mb-3">
                            <textarea type="" class="form-control pb-2 pt-3" id="modifierName" placeholder="Description"
                                style="line-height: 1;" asp-for="Description"></textarea>
                        </div>

                        <div class="modal-footer" style="border: none;">
                            <button type="submit" class="btn btn-primary" data-action="Add" id="saveNewModifier">Save</button>
                            <button type="submit" class="btn btn-primary" data-action="Update" id="updateModifier" >update</button>
                            <button type="button" class="btn btn-outline-primary cancelBtn"
                                data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
    </form>