@model ModifierModel
<partial name="_ValidationScriptsPartial" />
<h3 class="p-3 header-text">Modifiers</h3>
<div class="d-flex justify-content-end w-100 ">
    <div class="me-3">
        <input type="text" class="form-control h-100 " placeholder="Search">
    </div>
    <button class="btn btn-outline-secondary me-2"><img src="~/images/trash-fill.svg"
            onclick="deleleMultipleModifiersGet()" style="cursor: pointer;" alt=""></button>

    <button class="btn btn-primary me-3 add-item-modifier" type="button" onclick="openAddModifierModal()">+ New
        Modfifier</button>
    <input type="text" value="" hidden>
</div>
<div class="tbl m-3 table-container"></div>
<div class="addEditModelContainer"></div>
</div>
<script>
    $('document').ready(function () {
        loadModifiersForModifierGroup(2, 1);
    })

    function deleleMultipleModifiersGet(){
        @* alert("ok") *@
        var selectedModifiersToDelete = [...document.querySelectorAll(".IsModifierChecked:checked")].map(x => parseInt(x.value, 10));
        if(selectedModifiersToDelete.length < 1){
            toastr.error("please select modifiers to delete");
            return;
        }
        $.ajax({
            url:"@Url.Action("deleteItem","Menu")",
            method: 'GET',
            success:function(data){
                $(".addEditModelContainer").html(data);
                $("#exampleModalCenter8").modal("show");
                $(".deleteText").text( "Are you sure you want to delete this modifiers?");
            $(".deleteText").css('font-size', '17px');
            $(".singleItemDelete").css("display", "none");
            $(".modifierGroupDelete").css("display", "none");
            $(".multipleModifiersDelete").css("display", "block");
            $("#modifiersid_hidden").val(selectedModifiers);

            }
        });
    }

    function deleleMultipleModifiers() {
        var modifierGroupId = $('#modifierGroupId').val();
        var selectedModifiers = [...document.querySelectorAll(".IsModifierChecked:checked")].map(x => parseInt(x.value, 10));

        if ($('IsModifierChecked').length < 0) {
            toastr.error("please select modifiers to delete");
        }
        else {
            $.ajax({
                url: '@Url.Action("deleteMultipleModifiers", "Menu")',
                method: 'POST',
                data: { selectedModifiers: selectedModifiers, modifierGroupId: modifierGroupId },
                success: function (data) {
                    toastr.success("Modifiers Deleted Successfully");
                    loadModifiersForModifierGroup(data.modifierGroupId, 1);
                }
            });
        }
    }
</script>
</div>
