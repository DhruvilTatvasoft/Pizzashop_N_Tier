@model MenuOrderAppModel
<link rel="stylesheet" href="~/css/_menu.css">
<link rel="stylesheet" href="~/css/_menu.css">
@{
    Microsoft.AspNetCore.Html.IHtmlContent Tableids = new Microsoft.AspNetCore.Html.HtmlString("[]");
    if (Model.customer != null && Model.customer.tableids != null && Model.customer.tableids.Count > 0)
    {
        Tableids = Json.Serialize(Model.customer.tableids);
    }
    var isFromQr1 = ViewBag.isFromQr;
}


<div class="container-fluid w-100 h-100 p-0" style="overflow-y: hidden; overflow-x: hidden;">
    <div class="d-flex w-100 h-100">
        <input type="hidden" id="IsTableAssigned" asp-for="isTableAssigned" />
        <input type="hidden" id="tableid" asp-for="tableid" />
        <input type="hidden" id="tokenid" asp-for="tokenid" />
        <input type="hidden" id="customerid" asp-for="customer.customerId">
        <input type="hidden" id="orderid" asp-for="orderid">
        <input type="hidden" id="totalpersonCount" asp-for="customer.PersonCount">
        <h1>@ViewBag.isFromQr</h1>
        <div class="MenuSidebarContainer h-100"></div>
        <div class="MenuBodyContainer w-100 h-100"></div>
    </div>
</div>
<script>
    var itemWiseComment = [];
    $("document").ready(() => {
        loadSideBar();
        loadMenuDataContainer();
        if ($("#IsTableAssigned").val() != "False") {
            var requestedData = {
                customerid: $("#customerid").val(),
                tableids: @Html.Raw(Tableids),
                totalPersonCount: @Html.Raw(Model.customer?.PersonCount ?? 0),
                orderid: @Html.Raw(Model.orderid)
            }
            $.ajax({
                url: '@Url.Action("getOrderDetails", "MenuOrderApp")',
                method: 'POST',
                dataType: "html",
                contentType: "application/json",
                data: JSON.stringify(requestedData),
                success: function (data) {
                    $(".orderDetailContainer").html(data);
                }
            });
        }
    });
    function loadSideBar() {
        $.ajax({
            url: '@Url.Action("getMenuSidebar", "MenuOrderApp")',
            type: 'GET',
            success: function (data) {
                $('.MenuSidebarContainer').html(data);
            }
        });
    }
    function loadMenuDataContainer() {
        $.ajax({
            url: '@Url.Action("getMenuDataContainer", "MenuOrderApp")',
            type: 'GET',
            success: function (data) {
                $('.MenuBodyContainer').html(data);
            }
        });
    }
    function loadItemsForCategory(element, id, type) {
        $(".MenuSidebarContainer ul li").removeClass("selectedcategory  text-white");
        $(element).addClass("selectedcategory text-white");
        var searchedItem = $("#searchItemForCategory").val();
        var tokenId = $('#tokenid').val();
        var tableIds = @Html.Raw(Tableids);

        if (searchedItem) {
            id = $("#selectedCategory").val();
        }

        var requestedData = {
            customerId:@Html.Raw(Model.customer?.customerId ?? 0),
            CategoryId: id,
            TableIds: tableIds,
            SearchedItem: searchedItem,
            orderid: @Html.Raw(Model?.orderid),
            ItemType: type,
        }

    var data = JSON.stringify(requestedData);




    $.ajax({
        url: "@Url.Action("getItemsForCategory", "MenuOrderApp")",
        method: "POST",
        dataType: "html",
        contentType: "application/json",
        data: data,
        success: function (data) {
            $(".menuDataContainer").html(data);
            $("#selectedCategory").val(id);
        },
        error: function (error) {
            console.log('Error:', error);
        }
    });
    }


    function showItemDetailsModal(itemid) {

        $.ajax({
            url: "@Url.Action("getItemDetails", "MenuOrderApp")",
            type: "GET",
            data: { itemid: itemid, isTableAssigned: $('#IsTableAssigned').val() },
            success: function (data) {
                $("#itemDetailsModalContainer").html(data);
                $("#itemDetailsModal").modal("show");
            }
        });
    }

    function addNewItemInOrder(itemid, modifiers, uniqueId) {
        $.ajax({
            url: "@Url.Action("addItemInOrder", "MenuOrderApp")",
            type: "POST",
            data: { itemid: itemid, modifiers: modifiers, uniqueId: uniqueId, orderid: $("#orderid").val() },
            success: function (response) {
                $("#orderSummaryContainer").append(response);
                var itemprice = parseFloat($("#" + uniqueId).data("itemrate"));
                var quantity = parseInt($("#" + uniqueId + " .textInputForCounterInOrderItemDetailsKOT").val());
                var modifiersrate = parseFloat($("#" + uniqueId + " .modifierrate").data("modifierrate"));

                totalAmount += (itemprice + modifiersrate) * quantity;

                $("#subtotal").text("₹" + totalAmount);
                calculateTax($("#subtotal").text().replace("₹", ""))
                calculateTheTotalAmount()
                $(".cancelButton").click()
            }
        });
    }

    function calculateTax(subtotal) {
        var taxes = $('[id^="tax_"]');

        taxes.each(function () {
            var taxType = $(this).data("taxtype");
            var taxValue = $(this).data("taxpercentage")

            if (taxType == "flat amount") {
                if (subtotal == 0) {
                    $(this).text("₹0.0")
                }
                else {
                    $(this).text("₹" + taxValue)
                }
            }
            else {
                $(this).text("₹" + (taxValue * parseFloat(subtotal)) / 100);
            }
        })
    }
</script>