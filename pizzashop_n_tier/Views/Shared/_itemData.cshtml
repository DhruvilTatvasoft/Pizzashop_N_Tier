@model MenuOrderAppModel
<style>
    .body {
        overflow-y: auto;
    }
</style>
@{
    decimal totalModifierPrice = 0;
}

<div class="row" style="@(Model.customer == null ? "width:100%;height:100%;" : "width : 100%;height:100%;")overflow-x:hidden;overflow-y:auto;">
    <input type="hidden" id="IsTableAssigned" asp-for="isTableAssigned" />
    @foreach (var item in Model.items)
    {
        <div class="@(Model.customer == null ? "col-lg-3  pe-2 pb-3" : "col-lg-6  pe-2 pb-3") col-sm-6">
            <div class="itemCard d-flex" style="@(Model.customer == null ? "width:100%;" : "width : 100%;")cursor:pointer;"
                onclick="showItemDetailsModal(@item.Itemid)">
                <div style="width:25%;">
                    @if (item.Itemimage != null)
                    {
                        <img src="@item.Itemimage" style="width: 50px;" class="itemimage" alt="">
  
                    }
                    else
                    {
                        <img src="~/images/dining-menu.png" style="width: 50px;" class="" alt="">
                    }
                </div>
                <div class="itemDetailContainer pt-0 pe-0 d-flex justify-content-between p-2">
                    <div class="d-flex flex-column">
                        <label for="">@item.Itemname </label>
                        <label for="">@item.Itemrate</label>
                    </div>
                    @if (item.Itemtype)
                    {
                        <div class="d-flex justify-content-between flex-column">
                            <div class="typeIndicator p-2" style="background-color: green;">
                            </div>
                            <img src="~/images/heart.svg" class="AddToFavorite" onclick="AddToFavorite(this,@item.Itemid)"
                                onclick="AddToFavorite(this,@item.Itemid)" style="width: 15px;" alt="">
                        </div>

                    }
                    else
                    {
                        <div class="d-flex justify-content-between flex-column">
                            <div class="typeIndicator p-2" style="background-color: red ;">
                            </div>
                            <img src="~/images/heart.svg" class="AddToFavorite" onclick="AddToFavorite(this,@item.Itemid)"
                                style="width: 15px;" alt="">
                        </div>
                    }
                </div>
            </div>
        </div>

    }
</div>
</div>
<div class="customerDetailModalContainer"></div>
<script>

    $(document).on('submit',"#customer-details", function (e) {
        e.preventDefault();
        var data = new FormData(this);
        $.ajax({
            url: "@Url.Action("editCustomerDetails", "MenuOrderApp")",
            type: "POST",
            data: data,
            contentType: false,
            processData: false,
            success: function (response) {
                toastr.success(response.success);
                $("#closeCustomerDetailsModal").click();
                $("#totalpersonCount").val($("#personCount").val())
            }
        });
    })

    function showCustomerDetails(customerid) {
        $.ajax({
            url: "@Url.Action("showCustomerDetails", "MenuOrderApp")",
            type: "GET",
            data: { customerid: customerid,totalPersonCount : $("#totalpersonCount").val() },
            success: function (data) {
                $(".customerDetailModalContainer").html(data);
                $("#customerDetailModal").modal("show");
            }
        });
    }

    function calculateTheTotalAmount() {
        var subtotal = parseFloat($("#subtotal").text().replace('₹', ''));
        var sumOfTaxAmount = 0;
        var taxes = $('[id^="tax_"]');
        taxes.each(function () {
            
                sumOfTaxAmount += parseFloat($(this).text().replace('₹', ''));
            
        })
        console.log("subtotal:" + subtotal + "sum of tax" + sumOfTaxAmount)
        var total = subtotal + sumOfTaxAmount;
        $("#totalamount").text("₹" + total.toFixed(2));
    }
    function appliedTaxOrNot(element, value, type, name) {

        if (type == "flat amount") {
            if ($(element).prop("checked")) {

                totalAmount += parseFloat(value);
                var currentTotalAmount = parseFloat($("#totalamount").text().replace('₹', '')) + parseFloat(value);
                $("#totalamount").text("₹" + currentTotalAmount.toFixed(2))
                $("#tax_" + name).text("₹" + parseFloat(value))
            }
            else {
                totalAmount -= parseFloat(value);
                if (totalAmount > 0) {
                    var currentTotalAmount = parseFloat($("#totalamount").text().replace('₹', '')) - parseFloat(value);
                    $("#totalamount").text("₹" + currentTotalAmount.toFixed(2))
                    $("#tax_" + name).text("₹0.00")
                }
            }
        }
        else {
            if ($(element).prop("checked")) {
                totalAmount += parseFloat(value);
                var currentTotalAmount = parseFloat($("#totalamount").text().replace('₹', '')) + (parseFloat($("#subtotal").text().replace('₹', '')) * parseFloat(value)) / 100;
                $("#totalamount").text("₹" + currentTotalAmount.toFixed(2))
                $("#tax_" + name).text("₹" + (parseFloat($("#subtotal").text().replace('₹', '')) * parseFloat(value)) / 100)
            }
            else {
                totalAmount -= parseFloat(value);
                if (totalAmount > 0) {
                    var currentTotalAmount = parseFloat($("#totalamount").text().replace('₹', '')) - (parseFloat($("#subtotal").text().replace('₹', '')) * parseFloat(value)) / 100;
                    $("#totalamount").text("₹" + currentTotalAmount.toFixed(2))
                    $("#tax_" + name).text("₹0.00")
                }
            }
        }
    }



</script>