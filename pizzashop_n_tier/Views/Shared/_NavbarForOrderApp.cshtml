@{
    string imagepath = Context.Request.Cookies["UserImage"] ?? "/images/Default_pfp.svg.png";
    Layout = "";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
    integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
    crossorigin="anonymous"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<link rel="stylesheet" href="~/css/_navbarForOrderApp.css">

<body>
    <nav class="navbar sticky-top navbar-light d-flex">

        <div class="d-flex align-items-center w-100">
                <div class="dropdown1" >
                <button class="btn dropdown-toggle dropbtn" type="button" data-bs-toggle="dropdown"
                    aria-expanded="false" style="border: 0;">
                    <div  style="background-color: white;border-radius: 50%;">
                    <a href=""> <img src="~/images/pizzashop_logo.png" alt=""
                            style="width:50px;object-fit: cover; border-radius: 50%;border:3px solid white;"></a>

                    </div>
                </button>
                <ul class="dropdown-menu" id="nav-tab">

                    <li class="p-1"><a href="" class="p-2"><img src="~/images/clipboard2-fill copy.svg" class="me-2" alt=""><label
                                for="">KOT</label></a>
                    </li>
                    @if(User.IsInRole("Admin"))
                    {
                    <li  class="p-1"><a href="" class="p-2"><img src="~/images/clock-fill copy.svg" alt="" class="me-2"><label for="">Waiting
                                List</label></a></li>
                    <li class="p-1"><a href="" class="p-2" ><img src="~/images/stop-fill copy.svg" class="me-2" alt=""><label>Tables</label></a></li>
                    <li class="p-1"> <a href="" class="p-2"><img src="~/images/bell-fill copy.svg" class="me-2" alt=""><label for="">Menu</label></a></li>
                    }
                </ul>
            
                </div>
            
            <img src="~/images/pizzashop_logo.png" class="logo img-fluid" alt="">
            <label for="" class="text-white ms-2 header">PIZZASHOP</label>
            

            <div class="dropdown me-3 d-flex align-items-center"  style="margin-left: auto;">
                <div class="options" style="gap: 10px;">
                    <div>
                        <a href="" class="p-2 selectedOption"  id="KotInOrderApp" onclick="loadKot()"><img src="~/images/clipboard2-fill.svg" alt=""><label
                                for="">KOT</label></a>
                    </div>
                    @if(User.IsInRole("Admin"))
                    {
                    <div>
                        <a href="" class="p-2" id="waitingListInOrderApp"><img src="~/images/clock-fill.svg" alt=""><label for="">Waiting
                                List</label></a>
                    </div>
                    <div>
                        <a href="" class="p-2 " id="tableViewInOrderApp"><img src="~/images/stop-fill.svg" alt=""><label>Tables</label></a>
                    </div>
                    <div>
                        <a href="" class="p-2" id="menuInOrderApp"><img src="~/images/bell-fill.svg" alt=""><label for="">Menu</label></a>
                    </div>
                    }
                </div>
                <button class="btn dropdown-toggle dropbtn" type="button" data-bs-toggle="dropdown"
                    aria-expanded="false" style="border: 0;">
                    <a href=""> <img src="@imagepath" alt=""
                            style="width:30px;object-fit: cover; border-radius: 50%;border:3px solid white;"></a>
                </button>
                <ul class="dropdown-menu" id="myProfile">
                    <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Myprofile"><img
                                src="~/images/account.png" style="width:9%;"class="me-2" alt="" style="">My profile</a>
                    </li>
                    <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="ResetPassword"><img
                                src="~/images/reload.png" style="width:9%;"class="me-2" alt="">Change
                            Password</a></li>
                    <li><a class="dropdown-item" data-bs-toggle="modal" data-bs-target="#exampleModalCenter"><img
                                src="~/images/logout.png" style="width:8%;" class="me-2" alt="">Logout</a></li>
                    <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="showDashboard"><img
                                src="~/images/chevron-left.svg" style="width:8%;" class="me-2" alt="">Back</a></li>
                </ul>
            </div>
        </div>
    </nav>
    
    <main class="h-100">
        @RenderBody()
    </main>
</body>


</html>
<script>
    $('.options a').on('click', function (e) {
        e.preventDefault();
        $('.options a').removeClass('selectedOption');
        $(this).addClass('selectedOption');
    });   

    
     $('#tableViewInOrderApp').on('click',loadTables());
     function loadTables(){
          
          $.ajax({
               url:"@Url.Action("getTables","OrderApp")",
               method:"GET",
               success:function(data){
                    $(".loadTabBody").html(data);
               }
          });
     }
     
</script>