@model CustomerViewModel
<table class="table mb-0" id="table">
    <thead>
        <tr>
            <th scope="col">
                <label for="" class="me-2" >Name</label><img src="~/images/icons8-sorting-arrows-50.png" class="me-1" onclick="loadCustomerTable('name','@(Model.sortBy == "name" && Model.sortOrder == "asc" ? "desc" : "asc")','@(Model.pageNumber)','@Model.pageSize')" style="width: 15px;cursor: pointer;" alt="">
            </th>
            <th scope="col"><label for="" class="ps-4"><label for="" >Email</label></th>
            <th scope="col"><label for="" >Phone Number</label></th>
            <th scope="col">
                <label for=""><label for="" ><label for="" class="me-2">Date</label><img src="~/images/icons8-sorting-arrows-50.png" class="me-1" onclick="loadCustomerTable('date','@(Model.sortBy == "date" && Model.sortOrder == "asc" ? "desc" : "asc")','@(Model.pageNumber)','@Model.pageSize')" style="width: 15px;cursor: pointer;" alt=""></label>
            </th>
            <th scope="col"><label for="" ><label for="" class="me-2" >Total Order</label><img src="~/images/icons8-sorting-arrows-50.png" class="me-1" onclick="loadCustomerTable('totalOrders','@(Model.sortBy == "totalOrders" && Model.sortOrder == "asc" ? "desc" : "asc")','@(Model.pageNumber)','@Model.pageSize')" style="width: 15px;cursor: pointer;" alt=""></th>

        </tr>
    </thead>
    <tbody>
        @if(@Model.customers.Count <= 0){

            <tr>
                
    using NPOI.SS.Formula.Functions;
                <td colspan="5" class="text-center"><img src="~/images/exclamation-circle-fill.svg" class="p-3" alt="">No Orders Found</td>
                
            </tr>
        }
        else{
        @foreach (var customer in @Model.customers)
        {
            <tr onclick="loadCustomerHistory(@customer.Customerid)">
                <td><label class="ps-2">@customer.Customername</label></td>
                <td><label for="">@customer.Email</label></td>
                <td><label for="">@customer.Phonenumber</label></td>
                <td><label for="">@customer.Createdat</label></td>
                <td><label for="">@customer.Totalorders</label></td>
            </tr>
        }
        }
    </tbody>
</table>
    <div class="d-flex justify-content-end align-items-center w-100 bg-white pe-2">
        <label for="" class="me-2">items per page:</label>
        <div class="dropdown mt-2 me-2">
            <select class="form-select form-select-lg mb-3 pagesize" onchange="loadCustomerTable('@Model.sortBy','@Model.sortOrder','1','@Model.pageSize')" aria-label=".form-select-lg example">
            <option value="1" selected="@(Model.pageSize == 1 ? "selected" : null)">1</option>
            <option value="2" selected="@(Model.pageSize == 2 ? "selected" : null)">2</option>
            <option value="3" selected="@(Model.pageSize == 3 ? "selected" : null)">3</option>
            <option value="4" selected="@(Model.pageSize == 4 ? "selected" : null)">4</option>
            <option value="5" selected="@(Model.pageSize == 5 ? "selected" : null)">5</option>
            <option value="6" selected="@(Model.pageSize == 6 ? "selected" : null)">6</option>
            </select>
        </div>
        @{
    int startRecord = ((Model.pageNumber - 1) * Model.pageSize) + 1;
    int endRecord = Math.Min(Model.pageNumber * Model.pageSize, Model.totalCustomers);
}
    <label for="" class="me-2">Showing @startRecord - @endRecord of @Model.totalCustomers</label>
        <div class="d-flex mt-1">

    @if(Model.pageNumber > 1){
        <button type="button" class="btn btn-outline-dark btn2" style="padding: 6px;" onclick="loadCustomerTable('@Model.sortBy','@Model.sortOrder','@(Model.pageNumber-1)','@Model.pageSize')"><img src="" alt=""><img src="~/images/left-chevron-svgrepo-com.svg"
            style="width:25px" alt=""></button>
    }
    else{
        <button type="button" class="btn btn-outline-dark btn2" style="padding: 6px;" onclick="loadCustomerTable('@Model.sortBy','@Model.sortOrder','@(Model.pageNumber-1)','@Model.pageSize')" disabled><img src="" alt=""><img src="~/images/left-chevron-svgrepo-com.svg"
            style="width:25px" alt=""></button>
    }
            <!-- Debugger removed as it is not valid Razor syntax -->

            
        @if(Model.pageNumber*Model.pageSize < Model.totalCustomers){
        <button type="button" class="btn btn-outline-dark btn2 mb-2" style="padding: 5.8px;" onclick="loadCustomerTable('@Model.sortBy','@Model.sortOrder','@(Model.pageNumber+1)','@Model.pageSize')"><img src="~/images/left-chevron-svgrepo-com.svg"
            style="width:25px;rotate: 180deg;" alt=""></button>
        }
        else{
        <button type="button" class="btn btn-outline-dark btn2 mb-2" style="padding: 5.8px;" onclick="loadCustomerTable('@Model.sortBy','@Model.sortOrder','@(Model.pageNumber+1)','@Model.pageSize')" disabled><img src="~/images/left-chevron-svgrepo-com.svg"
            style="width:25px;rotate: 180deg;" alt=""></button>
        }
        </div>
</div> 
<div id="customerHistoryDiv"></div>


<script>
 function loadCustomerHistory(customerid){
        $('#CustomerHistory').modal('hide');
        $('#customerHistoryDiv').empty();
        
        $.ajax({
            url:'@Url.Action("getCustomerHistory","Customer")',
            type:'GET',
            data:{customerid:customerid},
            success:function(data){
                $('#customerHistoryDiv').html(data);
                $('#CustomerHistory').off('hidden.bs.modal').on('hidden.bs.modal', function () {
                    $(this).removeData('bs.modal');
                });
                
                $('#CustomerHistory').modal('show');
            },
            
        });
    }
  
</script>
    