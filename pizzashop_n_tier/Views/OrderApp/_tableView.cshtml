@model KotViewModel
<link rel="stylesheet" href="~/css/table.css">
<div class="container-fluid mt-4 ps-4 pe-4 h-100">
    <div class="mb-4">
        <div class="d-flex justify-content-between">
            <h1>Table View</h1>
            <div class="d-flex">
                <li class="me-3  mark-grey">Available</li>
                <ul style="list-style-type: circle;" class="ps-3">
                    <li class="me-3 mark-green">Selected</li>
                </ul>
                <li class="me-3 mark-green-filled">Assigned</li>
                <li class="me-3 mark-blue">Running</li>
            </div>
        </div>
    </div>
    <div class="w-100 h-100">
        <div>
            <div class="accordion" id="tableAndSectionContainer"></div>
        </div>
    </div>
</div>

<script>


    $(document).ready(()=>{
        $.ajax({
            url:'@Url.Action("getAllTablesAndSections","TableView")',
            type:'GET',
            success:function (data) {
                $('#tableAndSectionContainer').html(data);
            }
        });
    });
</script>