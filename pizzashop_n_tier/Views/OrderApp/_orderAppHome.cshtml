@{
     Layout = "~/Views/Shared/_NavbarForOrderApp.cshtml";
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
     integrity="sha512-7SRCYIJtR6F8ocwW7UxW6wGKqbSyqREDbfCORCbGLatU0iugBLwyOXpzhkPyHIFdBO0K2VCu57fvP2Twgx1o2A=="
     crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<div class="loadTabBody h-100"></div>
<script>
     $("document").ready(() => {
          @* const connection = new signalR.HubConnectionBuilder()
               .withUrl("/realtimehub")
               .build();
          connection.start().catch(err => console.error(err.toString()));
          connection.on("ReceiveMessage", (user, message) => {
               const msg = `${user}: ${message}`;
               const li = document.createElement("li");
               li.textContent = msg;
               document.getElementById("messagesList").appendChild(li);
          }); *@
          const urlParams = new URLSearchParams(window.location.search);
          const fromQr = urlParams.get('fromQr');
          if (fromQr == 'true') {
               loadMenuPage();
          }
          loadKot()
     });

     function loadKot() {
          $.ajax({
               url: '@Url.Action("getKot", "OrderApp")',
               method: 'GET',
               success: function (data) {
                    $('.loadTabBody').html(data);
               }
          });
     }

     function loadTables() {
          $.ajax({
               url: "@Url.Action("getTables", "OrderApp")",
               method: "GET",
               success: function (data) {
                    $(".loadTabBody").html(data);
               }
          });
     }

     function loadwaitingList() {
          $.ajax({
               url: '@Url.Action("getWaitingTokenPage", "OrderApp")',
               method: "GET",
               success: function (data) {
                    $(".loadTabBody").html(data);
               }
          })
     }

     function loadMenuPage() {
          $.ajax({
               url: "@Url.Action("getMenuPage", "OrderApp")",
               method: "GET",
               success: function (data) {
                    $(".loadTabBody").html(data);
               }
          });
     }

     $(document).on('click', '.Available-Table', function () {
          $(this).removeClass('Available-Table').addClass('selectedTable');
          var sectionid = $(this).data('sectionid')
          var id = "table_" + sectionid;
          setTimeout(1)
          if ($("#" + id + " .selectedTable").length > 0) {
               $("#assignBtn_" + sectionid).prop('disabled', false)
          }
     });
     
     $(document).on('click', '.selectedTable', function () {
          $(this).removeClass('selectedTable').addClass('Available-Table')
          var sectionid = $(this).data('sectionid')
          var id = "table_" + sectionid;
          if ($("#" + id + " .selectedTable").length == 0) {
               $("#assignBtn_" + sectionid).prop('disabled', true)
          }
     });

     function loadAddTokenModel() {
        $.ajax({
            url: "@Url.Action("getAddEditTokenModel", "WaitingList")",
            method: "GET",
            success: function (data) {
                $(".addEditModifierModelContainer").html(data);
                $("#addEditWaitingToken").modal('show');
                $("#updateToken").css("display", "none");
            }
        });
    }

    $(document).on("submit", "#AddEditWaitingTokenForm", function (e) {
        e.preventDefault();
        var tokenid = $("#tokenid").val();
        var url;
        if (tokenid == null || tokenid == 0) {
            url = "@Url.Action("AddNewWaitingToken", "WaitingList")"
        }
        else {
            url = "@Url.Action("UpdateWaitingToken", "WaitingList")"
        }
        var $form = $(this);

        if ($form.data('submitting')) return;
        $form.data('submitting', true);
        var data = new FormData(this);
        if (!$(this).valid()) {
            return false;
        }
        else {
            $.ajax({
                url: url,
                method: "POST",
                data: data,
                processData: false,
                contentType: false,
                success: function (data) {
                    if (data.success) {
                        $("#closeBtn").click();
                        toastr.success(data.success)
                        loadWaitingTokensForSection(data.sectionid);
                        loadSectionsNavbar();
                    }
                    else {
                        $("#closeBtn").click();
                        toastr.error(data.error)
                        loadWaitingTokensForSection(data.sectionid);
                    }
                }
            });
        }
    });
</script>