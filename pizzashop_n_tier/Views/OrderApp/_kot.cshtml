            <label for="" class="text-color" style="font-weight: 600;">#227</label>
            <label for="" class="ordertimeduration d-flex align-items-center"><img src="~/images/clock-fill copy 2.svg"
                alt="" class="me-1"><label for="">24 days 4 hours 14 min 57 sec</label></label>
          </div>
          <div class="d-flex">
            <label for="" class="me-2">Ground floor </label>
            <li>T2</li>
          </div>
        </div>
        <div class="" style="height:56%;background-color: white;"></div>
        <div class="p-1 container" style="background-color: #efefef;flex-grow:1;"></div>

