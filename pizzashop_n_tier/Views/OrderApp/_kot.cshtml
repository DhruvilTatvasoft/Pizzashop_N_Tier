@model KotViewModel

<link rel="stylesheet" href="~/css/kot.css">
<div class="container-fluid mt-4 ps-4 pe-4 h-100">
  <div class="mb-4">
    <h1>KOT</h1>
  </div>
  <div class="categoryNavbarContainer"></div>
  <div class="cardContainer w-100 h-100"></div>
</div>

<script>

  $('document').ready(() => {
    loadCategoryNavbar();
    @* loadOrders(); *@
    loadOrderDetailCardContainer(0);
  })

  function loadCategoryNavbar() {
    $.ajax({
      url: '@Url.Action("loadCategoryNavbar", "Kot")',
      type: 'GET',
      success: function (data) {
        $('.categoryNavbarContainer').html(data);
      }
    });
  }

  function loadOrderDetailCardContainer(categoryid){
    $.ajax({
      url:"@Url.Action("loadOrderDetailCardContainer","Kot")",
      type:"GET",
      data: {categoryid : categoryid},
      success:function(response){
        $(".cardContainer").html(response)
      }
    });
  }



  $(document).on('submit', '#readyQuantityChangeForm', function (e) {
    e.preventDefault();
    var $form = $(this);

    if ($form.data('submitting')) return;
    $form.data('submitting', true);

    var data = new FormData(this);
    for (var pair of data.entries()) {
      console.log(pair[0] + ', ' + pair[1]);
    }

    $.ajax({
      url: "@Url.Action("changeReadyQuantity", "Kot")",
      type: "POST",
      data: data,
      contentType: false,
      processData: false,
      complete: function () {
        $form.data('submitting', false);
      },
      success: function (response) {
        if (response.success) {
          $('.closeModalBtn').click();
          toastr.success(response.success);
          loadOrdersForcategory($('#selectedCategory').val(), false);
        }
      },
      error: function () {
        toastr.error("An error occurred while processing your request");
      }
    });
  });

  function loadOrders() {
    $.ajax({
      url: '@Url.Action("loadOrdersPerCategory", "Kot")',
      type: 'GET',
      data: { categoryid: 0 },
      success: function (data) {
        $('.orderdetailcontainer').html(data);

      }
    });
  }
</script>