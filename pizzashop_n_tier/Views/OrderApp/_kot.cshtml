@model KotViewModel

<link rel="stylesheet" href="~/css/kot.css">
<div class="container-fluid mt-4 ps-4 pe-4 h-100">
  <div class="mb-3">
    <h1>KOT</h1>
  </div>
  <div class="categoryNavbarContainer"></div>
  <div class="cardContainer w-100 h-100"></div>
  </div>
  
 <script>

  $('document').ready(()=>{
    loadCategoryNavbar();
    loadOrders();
  })

  function loadCategoryNavbar(){
    $.ajax({
      url:'@Url.Action("loadCategoryNavbar","OrderApp")',
      type:'GET',
      success:function(data){
        $('.categoryNavbarContainer').html(data);
      }
    });
  }



  function loadOrders(){
    $.ajax({
      url:'@Url.Action("loadOrderDetails","OrderApp")',
      type:'GET',
      success:function(data){
        $('.cardContainer').html(data);
        console.log(data);  
      }
    });
  }
</script> 