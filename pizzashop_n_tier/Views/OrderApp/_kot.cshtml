@model KotViewModel

<link rel="stylesheet" href="~/css/kot.css">
<div class="container-fluid mt-4 ps-4 pe-4 h-100" style="overflow-y: hidden;">
  <div class="mb-4">
    <h1>KOT</h1>
  </div>
  <div class="categoryNavbarContainer"></div>
  <div class="cardContainer w-100 h-100"></div>
</div>
<div id="loadingBackdrop" class="loading-backdrop" style="display: none;">
  <div class="spinner-border text-primary" role="status">
    <span class="visually-hidden">Loading...</span>
  </div>
</div>
<style>



.spinner-border {
  width: 3rem;
  height: 3rem;
  border-width: 0.4em;
}

</style>
<script>
  $('document').ready(() => {
    loadCategoryNavbar();
    loadOrderDetailCardContainer(0);
});

function showSpinner() {
    $('#loadingBackdrop').show(); 
}

function hideSpinner() {
    $('#loadingBackdrop').hide(); 
}
function loadCategoryNavbar() {
    showSpinner(); 
    $.ajax({
        url: '@Url.Action("loadCategoryNavbar", "Kot")',
        type: 'GET',
        success: function (data) {
            $('.categoryNavbarContainer').html(data);
            hideSpinner(); 
        }
    });
}

function loadOrderDetailCardContainer(categoryid) {
    showSpinner();
    $.ajax({
        url: "@Url.Action("loadOrderDetailCardContainer", "Kot")",
        type: "GET",
        data: { categoryid: categoryid },
        success: function (response) {
            $(".cardContainer").html(response);
            hideSpinner(); 
        }
    });
}

$(document).on('submit', '#readyQuantityChangeForm', function (e) {
    e.preventDefault();
    var $form = $(this);
    var isChecked = false;

    $('table tbody tr').each(function () {
        var $checkbox = $(this).find('input[type="checkbox"]');
        var $input = $(this).find('input[type="number"]');
        var readyQuantity = parseInt($input.val(), 10);

        if ($checkbox.is(':checked')) {
            isChecked = true;
        }
    });

    if (!isChecked) {
        toastr.warning("Please select at least one item to submit.");
        hideSpinner();
        return;
    }
    if ($form.data('submitting')) return;
    $form.data('submitting', true);

    var formData = new FormData();

    $('table tbody tr').each(function () {
        var $row = $(this);
        var $checkbox = $row.find('input[type="checkbox"]');
        var $input = $row.find('input[type="number"]');
        var inputId = $input.attr('id');
        var itemId = inputId.split('-')[1];
        var value = $checkbox.is(':checked') ? $input.val() : 0;
        formData.append(`readyItemCount[${itemId}]`, value);
    });
    formData.append("currentStatus", $("#currentStatus").val());

    $.ajax({
        url: "@Url.Action("changeReadyQuantity", "Kot")",
        type: "POST",
        data: formData,
        contentType: false,
        processData: false,
        complete: function () {
            $form.data('submitting', false);
        },
        success: function (response) {
            hideSpinner(); 
            if (response.success) {
                $('.closeModalBtn').click();
                toastr.success(response.success);
                loadOrdersForcategory($('#selectedCategory').val(),'',1);
            }
        },
        error: function () {
            hideSpinner(); 
            toastr.error("An error occurred while processing your request");
        }
    });
});

function loadOrders() {

    showSpinner();
    $.ajax({
        url: '@Url.Action("loadOrdersPerCategory", "Kot")',
        type: 'GET',
        data: { categoryid: 0 },
        success: function (data) {
            $('.orderdetailcontainer').html(data);
            hideSpinner();
        }
    });
}

function loadOrdersForcategory(categoryid, IsReady, pageNumber) {
    showSpinner();
    $.ajax({
        url: "@Url.Action("loadOrdersPerCategory", "Kot")",
        type: "GET",
        data: { categoryid: categoryid, IsReady: IsReady, pageNumber: pageNumber },
        success: function (data) {
            $('.orderdetailcontainer').html(data);
            hideSpinner();
            if (IsReady == true) {
                $(".btn").removeClass("activeBtn");
                $(".readybtn").addClass("activeBtn");
            } else if (IsReady == false) {
                $(".btn").removeClass("activeBtn");
                $(".inprogressbtn").addClass("activeBtn");
            }
        }
    });
}

</script>