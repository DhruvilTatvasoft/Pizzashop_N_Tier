@model KotViewModel

<link rel="stylesheet" href="~/css/kot.css">
<div class="container-fluid mt-4 ps-4 pe-4 h-100">
  <div class="mb-4">
    <h1>KOT</h1>
  </div>
  <div class="categoryNavbarContainer"></div>
  <div class="cardContainer w-100 h-100"></div>
</div>

<script>

  $('document').ready(() => {
    loadCategoryNavbar();

    loadOrderDetailCardContainer(0);
  })

  function loadCategoryNavbar() {
    $.ajax({
      url: '@Url.Action("loadCategoryNavbar", "Kot")',
      type: 'GET',
      success: function (data) {
        $('.categoryNavbarContainer').html(data);
      }
    });
  }

  function loadOrderDetailCardContainer(categoryid) {
    $.ajax({
      url: "@Url.Action("loadOrderDetailCardContainer", "Kot")",
      type: "GET",
      data: { categoryid: categoryid },
      success: function (response) {
        $(".cardContainer").html(response)
      }
    });
  }



  $(document).on('submit', '#readyQuantityChangeForm', function (e) {
    e.preventDefault();

    var $form = $(this);
    if ($form.data('submitting')) return;
    $form.data('submitting', true);

    var formData = new FormData();

    $('table tbody tr').each(function () {
        var $row = $(this);
        var $checkbox = $row.find('input[type="checkbox"]');
        var $input = $row.find('input[type="number"]');
        var inputId = $input.attr('id'); // e.g., "number-21"
        var itemId = inputId.split('-')[1]; // get "21"

        var value = $checkbox.is(':checked') ? $input.val() : 0;

        formData.append(`readyItemCount[${itemId}]`, value);
    });

    formData.append("currentStatus", $("#currentStatus").val());

    $.ajax({
        url: "@Url.Action("changeReadyQuantity", "Kot")",
        type: "POST",
        data: formData,
        contentType: false,
        processData: false,
        complete: function () {
            $form.data('submitting', false);
        },
        success: function (response) {
            if (response.success) {
                $('.closeModalBtn').click();
                toastr.success(response.success);
                loadOrdersForcategory($('#selectedCategory').val(), false);
            }
        },
        error: function () {
            toastr.error("An error occurred while processing your request");
        }
    });
});



  function loadOrders() {
    $.ajax({
      url: '@Url.Action("loadOrdersPerCategory", "Kot")',
      type: 'GET',
      data: { categoryid: 0 },
      success: function (data) {
        $('.orderdetailcontainer').html(data);

      }
    });
  }

  function loadOrdersForcategory(categoryid, IsReady, pageNumber) {
    @* var pageNumber = 1; *@
      console.log(pageNumber)
    $.ajax({
      url: "@Url.Action("loadOrdersPerCategory", "Kot")",
      type: 'GET',
      data: { categoryid: categoryid, IsReady: IsReady, pageNumber: pageNumber },
      success: function (data) {
        $('.orderdetailcontainer').html(data);

      }
    });
  }
</script>