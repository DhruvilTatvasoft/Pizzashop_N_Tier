@model KotViewModel

<link rel="stylesheet" href="~/css/kot.css">
<div class="container-fluid mt-4 ps-4 pe-4 h-100">
  <div class="mb-3">
    <h1>KOT</h1>
  </div>
  <nav>
    <div class="nav nav-tabs" id="nav-tab" role="tablist">
      <button class="nav-link active" id="nav-All-tab" data-bs-toggle="tab" data-bs-target="#nav-home" type="button"
        role="tab" aria-controls="nav-home" aria-selected="true">All</button>
      @foreach (var category in Model.categories)
      {
        <button class="nav-link" id="nav-home-tab" data-bs-toggle="tab"
          onclick="loadOrdersForcategory(@category.Categoryid)" data-bs-target="#nav-home" type="button" role="tab"
          aria-controls="nav-home" aria-selected="true">@category.Categoryname</button>
      }
    </div>
  </nav>
  <div class="tab-content mt-3" style="height:58%" id="nav-tabContent">
    <div class="tab-pane h-100 fade show pt-2  p-3" id="nav-home" role="tabpanel" aria-labelledby="nav-home-tab"
    using iText.IO.Font.Otf;
    using iText.IO.Font.Otf;
    using iText.IO.Font.Otf;
    using iText.IO.Font.Otf;
    using System.Reflection.Emit;
      tabindex="0">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
          <label for="" id="category-name"></label>
        </div>
        <div class="p-1">
          <button class="btn btn-primary btncolour"><label for="" class="inprogressText">In progress </label><img
              src="~/images/hourglass-top.svg" class="inprogressImg" alt=""></button>
          <button class="btn btn-outline-primary btnoutlinecolour">Ready</button>
          <button class="btn btn-outline-primary btnoutlinecolour ">"<"</button>
              <button class="btn btn-outline-primary btnoutlinecolour">">"</button>
        </div>
      </div>



      <div class="d-flex w-100" style="gap:20px;height:88%">
        @foreach (var order in Model.orderDetails)
        {
          <div style="min-width:280px;height:80%;" class="mt-2 orderDetailContainer d-flex flex-column">
            <div class="p-1" style="background-color: #efefef;">
              <div class="d-flex justify-content-between align-items-center">
                <label for="" class="text-color" style="font-weight: 600;">@order.Key</label>
                <label for="" class="ordertimeduration d-flex align-items-center"><img
                    src="~/images/clock-fill copy 2.svg" alt="" class="me-1"><label for="">24 days 4 hours 14 min 57
                    sec</label></label>
              </div>
              <div class="d-flex">

                <label for="" class="me-4">@Model.orderTableSectionDetail.Where(ot => ot.Key == order.Key)</label>
                <li>T2</li>
              </div>
            </div>

              <div class="mb-1" style="min-height:56%;overflow-x: auto;background-color: white;">
            @foreach (var item in order.Value.modifiersForItem)
            {

                <div class="d-flex justify-content-between align-items-center itemContainer ps-1 pe-1"
                  style="colour:rgb(251, 208, 155);">
                  <label for="">@item.Key.Itemname</label>
                  <label for="">@item.Key.Itemquantity</label>
                </div>
                <div class="itemContainer ps-1 pe-1">
                  @if(item.Value.Count > 0){
                  @foreach (var modifier in item.Value)
                  {
                    <li><label for="">@modifier.Modifiername</label></li>
                  }
                  }
                </div>
                <div class="d-flex justify-content-between align-items-center itemContainer ps-1 pe-1"
                  style="colour:rgb(251, 208, 155);">
                  <label for="">@item.Key.Itemname</label>
                  <label for="">@item.Key.Itemquantity</label>
                </div>
                <div class="itemContainer ps-1 pe-1">
                  @if(item.Value.Count > 0){
                  @foreach (var modifier in item.Value)
                  {
                    <li><label for="">@modifier.Modifiername</label></li>
                  }
                  }
                </div>
            }
              </div>
            <div class="p-1 container" style="background-color: #efefef;flex-grow:1;"></div>
          </div>
        }
      </div>
    </div>
  </div>
</div>
 <script>
  $('button').on('click', function (x) {
    console.log(this.innerHTML);
    $('#category-name').html(this.innerHTML);
  })

  function loadOrdersForcategory(categoryId) {
    $.ajax({
      type: "GET",
      url: '@Url.Action("LoadOrdersForCategory", "Kot")',
      data: { categoryId: categoryId },
      success: function (data) {
        $('#loadOrders').html(data);
      }
    });
  }
</script> 