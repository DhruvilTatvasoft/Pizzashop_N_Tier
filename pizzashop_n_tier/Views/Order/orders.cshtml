            var searchedOrder = $("#SearchOrder").val();
            var searchByPeriod = $(".timePeriodFilter").val();
            var startDate = $("#startDate").val();
            var endDate = $("#endDate").val();
            var searchbystatus = $("#selectStatus").val();

            $.ajax({
                url: '@Url.Action("ExportData", "Order")',
                type: 'POST',
                data: {
                    searchedOrder: searchedOrder,
                    searchByPeriod: searchByPeriod,
                    startDate: startDate,
                    endDate: endDate,
                    searchbystatus: searchbystatus
                },
                success: function (data) {
                    toastr.success(data.success);
                    showOrdersBySearch();
                }
            })
        } *@



        function exportProductExcelSheet() {
    var searchedOrder = $("#SearchOrder").val();
    var searchByPeriod = $(".timePeriodFilter").val();
    var startDate = $("#startDate").val();
    var endDate = $("#endDate").val();
    var searchbystatus = $("#selectStatus").val();

    $.ajax({
        url: '@Url.Action("ExportData", "Order")',
        type: 'POST',
        data: {
            searchedOrder: searchedOrder,
            searchByPeriod: searchByPeriod,
            startDate: startDate,
            endDate: endDate,
            searchbystatus: searchbystatus
        },
        xhrFields: {
            responseType: 'blob'  
        },
        success: function (data) {
            var blob = data;
            var link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'orderdetails_' + new Date().toISOString().slice(0, 19).replace(/[-T:]/g, "_") + '.xls'; 
            link.click();
        },
        error: function () {
            toastr.error("There was an error during the export.");
        }
    });
}

    </script>