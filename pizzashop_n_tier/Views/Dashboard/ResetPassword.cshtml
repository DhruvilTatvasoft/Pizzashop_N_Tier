        </div>
        <div class="modal fade" id="exampleModalCenter11" tabindex="-1" role="dialog"
            aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">

                    <div class="modal-body d-flex flex-column align-items-center justify-content-center">
                        <img src="~/images/icons8-alert-48.png" style="width:70px" class="mb-1" alt="">
                        <h5 class="mb-2">Are you sure you want to Change password?</h5>
                        <input type="hidden" id="#oldpass" asp-for="oldpass">
                        <input type="hidden" id="#newpass" asp-for="newpass">
                        <input type="hidden" id="#confirmpass" asp-for="confirmpass">
                        <div>
                            <button type="button" onclick="submit()" class="btn btn-primary" data-bs-dismiss="modal"
                                type="button">Yes</button>
                            <button type="reset" class="btn btn-outline-primary">No</button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <script>
         $('document').ready(()=>{
            loadResetPassView();
         })

         function loadResetPassView(){
            $.ajax({
                url:'@Url.Action("loadResetPassView","Dashboard")',
                method:'GET',
                success:function(data){
                    $('.resetpassformcontainer').html(data);
                }
            });
         }

        function submit() {
        var data = new FormData($('#changePasswordForm')[0]);  // Correct way to get FormData from form
        $.ajax({
        url: '@Url.Action("ResetPassword", "Dashboard")',
        type: 'POST',
        data: data,
        processData: false,  
        contentType: false,  
        success:function(){

            window.location.href = '@Url.Action("Index", "Login")';
        
        },
        error: function(xhr, status, error) {
            
            alert('Error: ' + error);
        }
    });
}
        function cancel() {
            console.log("cancel clicked");
            document.querySelector("inputPassword6").val() = "";
            document.querySelector("inputPassword5").val() = "";
        }

      
    </script>

