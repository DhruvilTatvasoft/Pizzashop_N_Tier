                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-xs-12 pb-3">
        <div class="container-fluid bg-white pb-3 pt-2 ps-3 dashboardCardsFirstRow slightBoxShadowStyle">
            <div class="row">
                <div class="container-fluid">
                    <h5>Least Selling Items</h5>
                </div>
            </div>
            <div class="row pt-2" id="leastSelling1Row">
                <div class="container-fluid d-flex align-items-center">
                    <h6 class="m-0 pe-2">#1</h6>
                    <div>
                        <img src="" id="leastSelling1Image" style="height:50px;width:50px" class="rounded-circle">
                    </div>
                    <div class="container-fluid p-0 ps-2">
                        <div class="row">
                            <span id="leastSelling1Name"></span>
                            <div class="d-flex align-items-center">
                                <img src="/images/icons/menu.svg" style="height:20px;width:20px">
                                <span id="leastSelling1NoOfOrders"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <hr class="my-2">
            <div class="row" id="leastSelling2Row">
                <div class="container-fluid d-flex align-items-center">
                    <h6 class="m-0 pe-2">#2</h6>
                    <div>
                        <img src="" id="leastSelling2Image" style="height:50px;width:50px" class="rounded-circle">
                    </div>
                    <div class="container-fluid p-0 ps-2">
                        <div class="row">
                            <span id="leastSelling2Name"></span>
                            <div class="d-flex align-items-center">
                                <img src="/images/icons/menu.svg" style="height:20px;width:20px">
                                <span id="leastSelling2NoOfOrders"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-xs-12 pb-3">
        <div class="container-fluid bg-white pb-3 ps-0 pt-2 dashboardCardsFirstRow slightBoxShadowStyle h-100">
            <div class="row">
                <div class="container-fluid d-flex justify-content-end">
                    <div class="totalSalesIconDiv">
                        <img src="/images/icons/camera.svg" class="p-2">
                    </div>
                </div>
            </div>
            <div class="container-fluid pt-5">
                <div class="row pt-3">
                    <div class="container-fluid">
                        <h4 class="mb-1" id="waitingListCountText">0</h4>
                    </div>
                </div>
                <div class="row">
                    <div class="container-fluid">
                        <span>Waiting List Count</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="customeDateSelectorModalLoader"></div>