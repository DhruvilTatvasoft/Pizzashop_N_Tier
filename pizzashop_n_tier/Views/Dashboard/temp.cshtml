                        <img src="" id="topSelling1Image" style="height:50px;width:50px" class="rounded-circle">
                    </div>
                    <div class="container-fluid p-0 ps-2">
                        <div class="row">
                            <span id="topSelling1Name"></span>
                            <div class="d-flex align-items-center">
                                <img src="/images/icons/menu.svg" style="height:20px;width:20px">
                                <span id="topSelling1NoOfOrders"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <hr class="my-2">
            <div class="row" id="topSelling2Row">
                <div class="container-fluid d-flex align-items-center">
                    <h6 class="m-0 pe-2">#2</h6>
                    <div>
                        <img src="" id="topSelling2Image" style="height:50px;width:50px" class="rounded-circle">
                    </div>
