@model RolesModel
@{
    Layout = "~/Views/Shared/_Sidebar&navbar.cshtml";
    ViewBag.Title = "Roles Page";
 var canEditPermission = (await AuthorizationService.AuthorizeAsync(User, "RolesAndPermissions_CanEditAdd")).Succeeded;
}
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

<link rel="stylesheet" href="~/css/roles.css">


<div class="row p-0 h-100 d-flex">
    <div class="content pt-3 w-100">
        <div class="header  mb-4 d-flex">
            <div>
                <h1>User</h1>
            </div>
        </div>
        <div class="w-75 p-4 bg-white">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Role</th>
                        <th scope="col" style="text-align: end;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in Model.Role)
                    {
                        <tr>
                            <td>@role.Rolename</td>
                            <td scope="col" style="text-align: end;">
                                @* @if(canEditPermission){ *@
                                <a href='@Url.Action("PermissionsOfRole", "Dashboard", new { Id = @role.Roleid })'><img
                                        src="~/images/pencil-square.svg" alt=""></a>
                                }
                                @* else{
                                <a onclick="showAccessDenied()"><img
                                        src="~/images/pencil-square.svg" alt=""></a>
                                } *@
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
</div>

<script>
     $("document").ready(function(){
      $('.sidebar ul li').removeClass('active-class');
             $('.roleandpermission').addClass('active-class')
  })
    function showAccessDenied(){
        toastr.error("Sorry,you don't have permissions to Edit the Permission");
    }
</script>
