@model chang_p_model
<partial name="_ValidationScriptsPartial" />
                        <form id="changepassform">
                            <div class="input-group mb-1 d-flex flex-column">
                                <input id="inputPassword3" placeholder="Current Password*" class="form-control in" asp-for="oldpass" style="width:100%">
                                <span asp-validation-for="oldpass" class="mb-1 mt-1 text-danger invalidmsg"></span>
                            </div>
                            <div class="input-group mb-1 d-flex flex-column w-100">
                                
                                <input type="password" id="inputPassword5" placeholder="New Password" class="form-control" asp-for="newpass"
                                    style="width:100%" aria-describedby="passwordHelpBlock">
                                <span asp-validation-for="confirmpass" class="mb-1 mt-1 text-danger invalidmsg"></span>
                            </div>
                            <div class="input-group mb-1 d-flex flex-column">
                                <small for="inputPassword5" class="form-label mb-1"></small>
                                <input type="password" id="inputPassword6" placeholder="Confirm New Password*" class="form-control in" style="width:100%"
                                    asp-for="confirmpass" aria-describedby="passwordHelpBlock">
                                <span asp-validation-for="confirmpass" class="mb-1 mt-1 text-danger invalidmsg"></span>
                            </div>
                            <div class="d-flex">
                                <button type="submit" class="btn btn-primary me-2">
                                    Submit
                                </button>
                                <button type="reset" class="btn btn-outline-primary">Cancel</button>
                            </div>
                        </form>
                
                <script>
                     $('#changepassformSubmit').on('click', function(e) {
                            e.preventDefault();
                            if ($('#changePasswordForm').valid()) {
                                $('#exampleModalCenter11').modal('show');
                                $('#oldpass').val($('#inputPassword3').val());
                                $('#newpass').val($('#inputPassword5').val());
                                $('#confirmpass').val($('#inputPassword6').val());
                            }
                        });
                </script>