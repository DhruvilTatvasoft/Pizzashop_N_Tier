@using Newtonsoft.Json
@{
  Layout = "~/Views/Shared/_Sidebar&navbar.cshtml";
  ViewData["Title"] = "Dashboard Page";
  var chartData = JsonConvert.SerializeObject(Model.dailySales);
  var chartData2 = JsonConvert.SerializeObject(Model.totalCustomers);
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.6.0/Chart.min.js" type="text/javascript"></script>
<script src="https://code.jquery.com/jquery-1.11.3.min.js"></script>



@model DashboardViewModel
<script>
  $("document").ready(function () {
    $('.sidebar ul li').removeClass('active-class');
    $('.dashboard').addClass('active-class')

    var aData = @Html.Raw(chartData);
    console.log(aData)
    var aLabels = Object.keys(aData);
    var aDatasets1 = Object.values(aData);
    var dataT = {
      labels: aLabels,
      datasets: [{
        data: aDatasets1,
        fill: true,
        backgroundColor: 'rgba(15, 135, 255, 0.2)',
        borderColor: '#0F87FF',
        borderWidth: 1
      }]
    };

    var ctx = $(".revenuechart").get(0).getContext("2d");

    var myNewChart = new Chart(ctx, {
      type: 'line',
      data: dataT,
      options: {
        responsive: true,
        legend: { position: 'top' },
        title: { display: false, text: 'Revenue' },
        scales: {
          xAxes: [{ gridLines: { display: true }, display: true, scaleLabel: { display: false, labelString: '' } }],
          yAxes: [{ gridLines: { display: true }, display: true, ticks: { stepSize: 70000, beginAtZero: false } }]
        }
      }
    });

    var aData2 = @Html.Raw(chartData2);
    console.log(aData2)
    var aLabelsForCustomer = Object.keys(aData2);
    var aDatasetsForCustomer1 = Object.values(aData2);
    var dataTForCustomer = {
      labels: aLabelsForCustomer,
      datasets: [{
        data: aDatasetsForCustomer1,
        fill: true,
        backgroundColor: 'rgba(15, 135, 255, 0.2)',
        borderColor: '#0F87FF',
        borderWidth: 1
      }]
    };

    var ctxForCustomer = $("#customerGrowth").get(0).getContext("2d");

    var myNewChartForCustomer = new Chart(ctxForCustomer, {
      type: 'line',
      data: dataTForCustomer,
      options: {
        responsive: true,
        legend: { position: 'top' },
        title: { display: false, text: 'Customer Growth' },
        scales: {
          xAxes: [{
            gridLines: { display: true },
            display: true,
            scaleLabel: { display: false, labelString: '' }
          }],
          yAxes: [{
            gridLines: { display: true },
            display: true,
        ticks: {
          stepSize: 1,
          beginAtZero: true
        }
      }]
    }
  }
});

  })





  function detailsByFilter() {
    console.log("OK")
    var selectedTime = $("#dashboardSelectTimeField").val();
    console.log(selectedTime)
    var link = "@Url.Action("showDashboard", "Dashboard", new { timeid = "selectedTime" })";
    link = link.replace("selectedTime", selectedTime);
    window.location.href = link
  }

</script>
<link rel="stylesheet" href="~/css/maindashboard.css">
