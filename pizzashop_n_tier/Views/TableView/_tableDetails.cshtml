@model TableViewModel
@{
	int index = 0;
}
@foreach(var pair in @Model.tablesPerSection){ 
		<div class="accordion-item mb-2">
			<h2 class="accordion-header" id="heading@(index)">
				<div class="d-flex">
					<button class="accordion-button ps-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapse@(index)" aria-expanded=" @(index == 0 ? "true" : "false") aria-controls="collapseOne">
						<div class="ms-2 w-100">
							<div class="d-flex justify-content-between align-items-center">
								<label for="">@pair.Key.section.Sectionname</label>
								<div class="d-flex align-items-center">
									<li class="me-3  mark-grey">@pair.Key.AvailableTablesCount</li>
									@* <ul style="list-style-type: circle;" class="ps-3 mb-0">
										<li class="me-3 mark-green"></li>
									</ul> *@
									<li class="me-3 mark-green-filled">@pair.Key.AssignedTablesCount</li>
									<li class="me-2 mark-blue">@pair.Key.RunningTablesCount</li>
								</div>
							</div>
						</div>
					</button>
					<div style="width:12%;padding:5px;border-bottom: 1px solid #dee2e6;" class="d-flex justify-content-center align-items-center pe-4">
    
						<button class="btn btnoutlinecolour" style="font-size: 13px;height: 100%;">+ Waiting Token</button>
					</div>
				</div>
			</h2>
			<div id="collapse@(index)" class="accordion-collapse collapse  @(index == 0 ? "show" : "")" aria-labelledby="heading@(index)" data-bs-parent="#tableAndSectionContainer">
				<div class="accordion-body ">
					<div class="d-flex row " id="table_@pair.Key.section.Sectionid">
							@foreach(var table in pair.Value){
						<div class=" p-2 ps-3 col-2 mb-2" style="font-size: 12px;">
							<div class="@table.Statusname-Table"  data-sectionid="@pair.Key.section.Sectionid">
								<div class="d-flex flex-column">
									<div class="d-flex justify-content-between align-items-center">
										<h6 for="">@table.Tablename</h6>
										<label for="">₹ 142.00</label>
									</div>
									<div class="d-flex justify-content-between align-items-center mb-1">
										<img src="~/images/icons8-group-30.png" style="width: 15px;" alt="">
										<img src="~/images/clock-fill copy 2.svg" alt="" class="me-5">
									</div>
									<div class="d-flex justify-content-between align-items-center">
										<label for="">@table.Capacity</label>
										<label for="" style="font-size: 12px;" class="w-50">@table.Createdat.Value.Day days @table.Createdat.Value.Hour hours @table.Createdat.Value.Minute min @table.Createdat.Value.Second sec</label>
									</div>
								</div>
							</div>
						</div>
						index++;
							}
							  
					</div>
					<div class="d-flex align-items-center justify-content-end"><button class="btn btn-primary btncolour" id="assignBtn_@pair.Key.section.Sectionid" data-bs-toggle="offcanvas" onclick="openAssignOffCanvas(@pair.Key.section.Sectionid)" data-bs-target="#offcanvasRight" aria-controls="offcanvasRight" disabled >Assign</button></div>
				</div>
			</div>
		</div>
}

<div class="OffCanvasContainer">
	<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel">
  <div class="offcanvas-header">
    <label id="offcanvasRightLabel" class="headerTEXT" style="font-weight: 600;font-size: 20px;">Waiting List</label>
    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
	<div class="WaitingTokendata"></div>
  </div>
</div>

</div>

<script>
	function openAssignOffCanvas(sectionid){
		$.ajax({
			url:"@Url.Action("getOffCanvas","TableView")",
			type: "GET",
			data:{sectionid : sectionid},
			success: function(data){
				$(".WaitingTokendata").html(data);
				@* $(".offcanvas").show() *@
			}
		});
	}
</script>
