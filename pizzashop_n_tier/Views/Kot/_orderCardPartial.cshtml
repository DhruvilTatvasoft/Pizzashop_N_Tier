@model KotViewModel
@if (Model.orderDetails.Count == 0)
{
    <h1>No Orders Found !!</h1>
}
<div class="d-flex justify-content-between">
<div>
    <label for="" id="category-name">@(Model.categoryName ?? "All")</label>
</div>
<div class="p-1 ">
    <button class="btn btn-primary inprogressbtn" onclick="inprogress(this,@Model.categoryid,false)"
        style="color: #0066a7;border-color: #0066a7;background-color:white;border-radius: 2px;"><label for=""
            class="inprogressText">In progress </label>
        <img src="~/images/hourglass-top.svg" class="inprogressImg" alt=""></button>
    <button class="btn btn-outline-primary  readybtn" onclick="inprogress(this,@Model.categoryid,true)"
        style="color: #0066a7;border-color: #0066a7;border-radius: 2px;">Ready</button>

    <button class="btn btn-outline-primary btnoutlinecolour " onclick="loadOrdersForcategory(@Model.categoryid,temp,@(Model.pageNumber-1))" @Model.> &lt;
    </button>
    <button class="btn btn-outline-primary btnoutlinecolour" onclick="loadOrdersForcategory(@Model.categoryid,temp,@(Model.pageNumber+1))">
        &gt;</button>
</div>
</div>
<div class="d-flex ms-3" style="width:100%;">
    @foreach (var order in Model.orderDetails)
    {
        <div class="mt-2 orderDetailContainer me-3 d-flex flex-column p-0"
            onclick="openModalForStatusChange(@order.Key.Orderid)">
            <div class="p-1" style="background-color: #efefef;">
                <div class="d-flex justify-content-between align-items-center">
                    <label for="" class="text-color" style="font-weight: 600;"># @order.Key.Orderid</label>
                    <label for="" id="duration-waitingtime-@order.Key.Orderid"
                        data-createdatWaitingToken="@order.Key.Createdat?.ToString("o")">
                    </label>
                    <script>
                        @* updateTimers(); *@
                    </script>
                </div>
                <div class="d-flex">
                    <label for="" class="me-4">@Model.orderTableSectionDetail[order.Key.Orderid].sectionName</label>
                    <li>@Model.orderTableSectionDetail[order.Key.Orderid].tableName</li>
                </div>
            </div>

            <div class="mb-1" style="    min-height: 150px;max-height:150px;overflow-x: auto;background-color: white;">
                @foreach (var list in order.Value)
                {
                    @foreach (var itemDict in list)
                    {
                        <div class="d-flex justify-content-between align-items-center itemContainer ps-1 pe-1"
                            style="colour:rgb(251, 208, 155);">
                            <label for="">@itemDict.Key.Itemname</label>
                            <label for="">@itemDict.Key.Itemquantity</label>
                        </div>
                        <div class="itemContainer ps-1 pe-1">
                            @if (itemDict.Value.Count > 0)
                            {
                                @foreach (var modifier in itemDict.Value)
                                {
                                    <li><label for="">@modifier.Modifiername</label></li>
                                }
                            }
                        </div>
                    }
                }
            </div>
            <div class="p-1 container" style="background-color: #efefef;flex-grow:1;"></div>
        </div>
    }
</div>