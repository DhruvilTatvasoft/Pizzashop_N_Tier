@model SingleOrderDetailModel
<form id="readyQuantityChangeForm">
    <div class="modal fade" id="modalForItemStatusChange" tabindex="-1" role="dialog"
        aria-labelledby="exampleModalCenterTitle" aria-hidden="false">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content w-75">
                <div class="modal-header d-flex pb-0" style="border: none;">
                    <h5 class="modal-title"><label for="" style="font-weight: bold;">Order id : #<span
                                id="orderid">@Model.orderid</span></label></h5>
                    <button type="button" class="close" data-bs-dismiss="modal"
                        style="margin-left:  auto; background-color: transparent;border: none;font-size:21px;"
                        aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="d-flex w-100 align-items-center justify-content-center p-2">
                    <input type="hidden" id="currentStatus">
                    <button class="btn btn-outline-primary me-2 btnforready" type="button"
                        onclick="loadStatusWiseOrderItems('Ready')">Ready</button>
                    <button class="btn btn-outline-primary btnforinprogress" type="button"
                        onclick="loadStatusWiseOrderItems('In Progress')">In Progress</button>
                </div>
                <div
                    class="modal-body d-flex flex-column align-items-center justify-content-center ps-1 pe-1 pt-0 pb-0">
                    <div class="statusWiseItems w-100"></div>
                </div>
                <div class="modal-footer pt-0" style="border:none;">
                    <button class="btn btn-primary btncolour markAsBtn" type="submit">Marked As Prepared</button>
                    <button class="btn  btnoutlinecolour closeModalBtn" data-bs-dismiss="modal">cancel</button>
                <label class="w-100 mt-3" style="font-size: 10px;">*Please mark the checkbox before marking item as Ready or In Progress</label>
                </div>
            </div>
        </div>
    </div>
</form>


<script>
    $("document").ready(() => {
        console.log("ready")
        loadStatusWiseOrderItems("In Progress");
    })
    function loadStatusWiseOrderItems(status) {
        if (status == "In Progress") {
            $(".btnforinprogress").removeClass("btn-outline-primary")
            $(".btnforinprogress").addClass("btn-primary")
            $(".btnforready").removeClass("btn-primary")
            $(".btnforready").addClass("btn-outline-primary")
            $(".markAsBtn").text("Mark As Prepared")
            $("#currentStatus").val("In Progress")
        }
        else {
            $(".btnforready").removeClass("btn-outline-primary")
            $(".btnforready").addClass("btn-primary")
            $(".btnforinprogress").removeClass("btn-primary")
            $(".btnforinprogress").addClass("btn-outline-primary")
            $(".markAsBtn").text("Mark As InProgress")
                        $("#currentStatus").val("Ready")
        }
        $.ajax({
            url: "@Url.Action("loadItemsInModalAccordingToStatus", "Kot")",
            type: "GET",
            data: { categoryid:@Model.categoryid, orderid:@Model.orderid, status: status },
            success: function (response) {
                $(".statusWiseItems").html(response);
            }
        });
    }

</script>