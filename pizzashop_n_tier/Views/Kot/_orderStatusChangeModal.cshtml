@model SingleOrderDetailModel
 <form id="readyQuantityChangeForm">
<div class="modal fade" id="modalForItemStatusChange" tabindex="-1" role="dialog"
            aria-labelledby="exampleModalCenterTitle" aria-hidden="false">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content w-75">
                    <div class="modal-header d-flex pb-0" style="border: none;">
                        <h5 class="modal-title"><label for="" style="font-weight: bold;">Order id : #<span
                                    id="orderid">@Model.orderid</span></label></h5>
                        <button type="button" class="close" data-bs-dismiss="modal"
                            style="margin-left:  auto; background-color: transparent;border: none;font-size:21px;"
                            aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body d-flex flex-column align-items-center justify-content-center ps-1 pe-1 pt-0 pb-0">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th scope="col">Item</th>
                                    <th scope="col" class="d-flex justify-content-end" style="padding-right:19%;">Quantity</th>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                               
                                @foreach(var item in Model.itemAndModifiers){
                                <tr>
                                   
                                   <td><input class="form-check-input" type="checkbox"> 
                                   <label for="">@item.Key.Itemname</label>
                                   <div class="ps-2 modifierForItem">
                                    @foreach(var modifier in item.Value){
                                        <li>@modifier.Modifiername</li>
                                    }
                                   </div>
                                    <td>
                                            <div class="incrementerContainer">
                                            <div class="value-button h-100" id="decrease" onclick="decreaseValue('number-@item.Key.Itemid')"
                                                value="Decrease Value">-</div>    
                                            <input type="number h-100" class="number" id="number-@item.Key.Itemid" min="0" max="@item.Key.Itemquantity" value="0" name="readyItemCount[@item.Key.Itemid]" />
                                            <div class="value-button h-100" id="increase" onclick="increaseValue(@item.Key.Itemquantity,'number-@item.Key.Itemid')"
                                                value="Increase Value">+</div>
                                            </div>
                                    </td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="modal-footer pt-0" style="border:none;">
                        <button class="btn btn-primary btncolour" type="submit">Marked As Prepared</button>
                        <button class="btn  btnoutlinecolour closeModalBtn" data-bs-dismiss="modal">cancel</button>
                    </div>
                </div>
            </div>
        </div>
  </form>


    <script>
        

    </script>