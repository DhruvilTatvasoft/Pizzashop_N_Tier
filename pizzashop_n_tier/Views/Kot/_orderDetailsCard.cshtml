@model KotViewModel
<div class=" mt-3 tabDataContainer" style="background-color: white;">
    <div class="tab-pane fade show pt-2  p-3" id="nav-home" role="tabpanel" aria-labelledby="nav-home-tab" tabindex="0"
        style="min-height: 385px;">
        <input type="hidden" id="selectedCategory" asp-for="@Model.categoryid" />
        <div class="d-flex align-items-center justify-content-between mb-3">

            <div class="orderdetailcontainer p-1 w-100"></div>
            <div class="modalContainer"></div>
            <script>
                $("document").ready(() => {
                    loadOrdersForcategory(0)
                })
                var temp = null;
                function inprogress(button, id, IsReady) {
                    $(".btn").removeClass("activeBtn");
                    $(button).addClass("activeBtn");
                    loadOrdersForcategory(id, IsReady)
                    temp = IsReady
                }
                function ready(id, IsReady) {
                    loadOrdersForcategory(id, 'true')
                }

                function increaseValue(maxvalue, id) {

                    var value = document.getElementById(id).value;
                    value = isNaN(value) ? 0 : value;
                    if (value < maxvalue)
                        value++;

                    document.getElementById(id).value = value;
                }

                function decreaseValue(id) {
                    var value = parseInt(document.getElementById(id).value, 10);
                    value = isNaN(value) ? 0 : value;
                    value < 1 ? value = 1 : '';
                    value--;
                    document.getElementById(id).value = value;
                }

                $('.nav-link').on('click', function (x) {
                    $('#category-name').html(this.innerHTML);
                });

                function openModalForStatusChange(orderid) {
                    $.ajax({
                        url: "@Url.Action("loadSingleOrderDetails", "Kot")",
                        type: 'GET',
                        data: { categoryid: $('#selectedCategory').val(), orderid: orderid },
                        success: function (data) {
                            $(".modalContainer").html(data);
                            $("#modalForItemStatusChange").modal('show');
                        }
                    });
                }
                function updateTimers() {
                    const now = new Date();
                    document.querySelectorAll("[id^='duration-waitingtime-']").forEach(timerEl => {
                        const createdAtStr = timerEl.getAttribute("data-createdatWaitingToken");
                        if (createdAtStr) {
                            const createdAt = new Date(createdAtStr);
                            if (isNaN(createdAt.getTime())) {
                                console.error("Invalid date:", createdAtStr);
                                return;
                            }
                            const diffMs = now - createdAt - 12;


                            if (!isNaN(diffMs)) {
                                let totalSeconds = Math.floor(diffMs / 1000);
                                const hours = Math.floor(totalSeconds / 3600);
                                totalSeconds %= 3600;
                                const minutes = Math.floor(totalSeconds / 60);
                                const seconds = totalSeconds % 60;
                                const formatted = `${pad(hours)}hrs ${pad(minutes)}mins ${pad(seconds)}sec`;

                                timerEl.textContent = formatted;
                            } else {
                                console.error("Time difference is NaN", diffMs);
                            }
                        } else {
                            console.error("CreatedAt data is missing or invalid.");
                        }
                    });
                }

                function pad(num) {
                    return num < 10 ? "0" + num : num;
                }

                setInterval(updateTimers, 1000);



            </script>