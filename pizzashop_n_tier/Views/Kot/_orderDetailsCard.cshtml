@model KotViewModel
<div class=" mt-3 tabDataContainer" style="height:58%;background-color: white;">
    <div class="tab-pane h-100 fade show pt-2  p-3" id="nav-home" role="tabpanel" aria-labelledby="nav-home-tab"
        tabindex="0">
     
        <input type="hidden" id="selectedCategory" asp-for="@Model.categoryid"/>
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <label for="" id="category-name">@(Model.categoryName ?? "All")</label>
            </div>
            <div class="p-1">
                <button class="btn btn-primary inprogressbtn" style="background-color: #0066a7;border-radius: 2px;"><label for="" class="inprogressText"
                        onclick="inprogress(this,@Model.categoryid,'false')">In progress </label><img
                        src="~/images/hourglass-top.svg" class="inprogressImg" alt=""></button>
                <button class="btn btn-outline-primary  readybtn" style="color: #0066a7;border-color: #0066a7;border-radius: 2px;"
                    onclick="inprogress(this,@Model.categoryid,'true')">Ready</button>
                <button class="btn btn-outline-primary btnoutlinecolour "><</button>
                        <button class="btn btn-outline-primary btnoutlinecolour">></button>
            </div>
        </div>
        <div class="d-flex ms-3" style="height:88%;overflow-x: auto;width:100%;">


            @foreach (var order in Model.orderDetails)
            {

                <div class="mt-2 orderDetailContainer me-3 d-flex flex-column p-0"
                    onclick="openModalForStatusChange(@order.Key.Orderid)">
                    <div class="p-1" style="background-color: #efefef;">
                        <div class="d-flex justify-content-between align-items-center">
                            <label for="" class="text-color" style="font-weight: 600;"># @order.Key.Orderid</label>
                            <label for="" id="duration-waitingtime-@order.Key.Orderid" data-createdatWaitingToken="@((order.Key.Createdat as DateTime?)?.ToString("o") ?? "")">
                                                                    </label>
                            <script>
                                updateTimers();
                            </script>                                       
                        </div>
                        <div class="d-flex">
                            <label for="" class="me-4">@Model.orderTableSectionDetail[order.Key.Orderid].sectionName</label>
                            <li>T2</li>
                        </div>
                    </div>

                    <div class="mb-1" style="height:56%;overflow-x: auto;background-color: white;">
                        @foreach (var list in order.Value)
                        {
                            @foreach (var itemDict in list)
                            {
                                <div class="d-flex justify-content-between align-items-center itemContainer ps-1 pe-1"
                                    style="colour:rgb(251, 208, 155);">
                                    <label for="">@itemDict.Key.Itemname</label>
                                    <label for="">@itemDict.Key.Itemquantity</label>
                                </div>
                                <div class="itemContainer ps-1 pe-1">
                                    @if (itemDict.Value.Count > 0)
                                    {
                                        @foreach (var modifier in itemDict.Value)
                                        {
                                            <li><label for="">@modifier.Modifiername</label></li>
                                        }
                                    }
                                </div>
                            }
                        }
                    </div>
                    <div class="p-1 container" style="background-color: #efefef;flex-grow:1;"></div>
                </div>

            }
        </div>

        <div class="modalContainer"></div>
        <script>

            function inprogress(button,id,IsReady){
                loadOrdersForcategory(id,IsReady)
                button.style.backgroundColor = "#39a7ed";
                button.style.borderColor = "#39a7ed";
            }
            function ready(id,IsReady){
                loadOrdersForcategory(id,'true')
            }

            function increaseValue(maxvalue,id) {
                
                    var value = document.getElementById(id).value;
                    value = isNaN(value) ? 0 : value;
                    if(value < maxvalue)
                    value++;    

                    document.getElementById(id).value = value;
                }

            function decreaseValue(id) {
                    var value = parseInt(document.getElementById(id).value, 10);
                    value = isNaN(value) ? 0 : value;
                    value < 1 ? value = 1 : '';
                    value--;
                    document.getElementById(id).value = value;
                }

            $('.nav-link').on('click', function (x) {
                $('#category-name').html(this.innerHTML);
            });

            function openModalForStatusChange(orderid) {
                 $.ajax({
                    url:"@Url.Action("loadSingleOrderDetails","Kot")",
                    type:'GET',
                    data:{categoryid : $('#selectedCategory').val(),orderid:orderid},
                    success:function(data){
                        $(".modalContainer").html(data);
                        $("#modalForItemStatusChange").modal('show');
                    }
                });
            }

            function pad(num) {
    return num < 10 ? "0" + num : num;
}

function updateTimers() {
        const now = new Date();
        document.querySelectorAll("[id^='duration-waitingtime-']").forEach(timerEl => {
            const createdAtStr = timerEl.getAttribute("data-createdatWaitingToken");
            const createdAt = new Date(createdAtStr);

            const diffMs = now - createdAt;

            if (!isNaN(diffMs)) {
                let totalSeconds = Math.floor(diffMs / 1000);

                const hours = Math.floor(totalSeconds / 3600);
                totalSeconds %= 3600;

                const minutes = Math.floor(totalSeconds / 60);
                const seconds = totalSeconds % 60;

                const formatted = `${pad(hours)}hrs ${pad(minutes)}mins ${pad(seconds)}sec`;
                timerEl.textContent = formatted;
        }
    });
}

setInterval(updateTimers, 1000);


        </script>